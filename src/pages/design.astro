---
import DesignOverview from "@components/project/DesignOverview.astro";
import PageHero from "@components/shared/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, webPageJsonLd } from "@data/metadata";
import "@styles/pages/project.css";

const meta = { title: "Architecture", description: "How VitaeContext separates supplied career material, reusable context, controlled retrieval, and downstream career workflows.", path: "/design/", type: "website" as const, image: "/og/design.png" };
---
<BaseLayout meta={meta} jsonLd={[webPageJsonLd(meta.title, meta.description, meta.path), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Design", path: meta.path }])]}>
  <PageHero eyebrow="System architecture" title="How the context layer fits." text="VitaeContext sits between selected career material and the agents or systems that use it. Context stays portable; task execution stays downstream." actions={[{ label: "Read the source design", href: "https://github.com/vitaecontext/vitaecontext/blob/main/DESIGN.md", tone: "primary" }, { label: "See how it works", href: "/docs/usage/" }]} compact />
  <DesignOverview />
</BaseLayout>
