---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContextCode from "@components/ContextCode.astro";
import { articleJsonLd, breadcrumbJsonLd } from "@data/metadata";
import { sampleContext } from "@data/sampleContext";
import "@styles/pages/context-example.css";

const meta = {
  title: "Personal Career Context File Example and Template",
  description:
    "Explore a readable personal career context file template covering education, experience, projects, skills, certifications, goals, evidence, and AI agent instructions.",
  path: "/docs/context-file-example/",
  type: "article" as const,
};

const contextSections = [
  {
    label: "Quick reference",
    text: "A selective YAML snapshot gives an agent current positioning, target roles, strongest skills, credentials, and public links without loading the full history.",
  },
  {
    label: "Evidence boundary",
    text: "The scope declaration and verified-facts anchors separate reusable facts from goals, drafts, self-reported details, and claims that still need evidence.",
  },
  {
    label: "Education and research",
    text: "Degrees, coursework, theses, publications, and academic projects preserve the detail that usually disappears from a short CV.",
  },
  {
    label: "Experience and projects",
    text: "Roles and projects connect responsibilities, technologies, constraints, results, and proof links to a specific source.",
  },
  {
    label: "Skills and credentials",
    text: "The skills index, certifications, achievements, and languages stay usable because every important claim is supported elsewhere in the file.",
  },
  {
    label: "Goals and output rules",
    text: "Target roles, interests, preferred tone, and claims to avoid tell the agent what direction to support without rewriting aspirations as experience.",
  },
];
---

<BaseLayout
  meta={meta}
  jsonLd={[
    articleJsonLd(meta.title, meta.description, meta.path),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Docs", path: "/docs/" },
      { name: "Context file example", path: meta.path },
    ]),
  ]}
>
  <section class="page-hero context-example-hero">
    <div class="inner">
      <p class="eyebrow">A concrete example</p>
      <h1>What goes inside a career context file?</h1>
      <p>Inspect a fictional template before creating a career context file for AI-assisted work.</p>
      <div class="actions">
        <a class="button primary" href="#annotated-example">Explore the annotated example</a>
        <a class="button secondary" href="/examples/sample-career-context.md">View raw Markdown</a>
        <a class="button secondary" href="/docs/usage/">See how to use it</a>
      </div>
    </div>
  </section>

  <section class="page-section context-example-intro">
    <div>
      <p class="eyebrow">The idea</p>
      <h2>Keep career context in one maintained file.</h2>
    </div>
    <p>
      A personal career context file is an editable local Markdown record for your education, experience,
      projects, research, skills, certifications, achievements, goals, links, and evidence. Agents read it before
      working on a CV, LinkedIn profile, GitHub profile, portfolio, application, or interview task.
    </p>
  </section>

  <section class="page-section context-benefit-grid" aria-label="Benefits of a career context file">
    <article>
      <span>01</span>
      <h2>One maintained record</h2>
      <p>Dates, roles, education, projects, credentials, links, and hard facts stay in one maintained local file.</p>
    </article>
    <article>
      <span>02</span>
      <h2>Visible evidence boundaries</h2>
      <p>The file tells the agent what is verified, what is only a goal, and which claims it must not invent.</p>
    </article>
    <article>
      <span>03</span>
      <h2>Reuse across tasks</h2>
      <p>The same facts can support CVs, profiles, portfolios, applications, and interviews without making every output identical.</p>
    </article>
  </section>

  <section class="page-section context-anatomy" aria-labelledby="context-anatomy-heading">
    <div class="context-anatomy-head">
      <p class="eyebrow">File anatomy</p>
      <h2 id="context-anatomy-heading">What the context file stores and why</h2>
      <p>Each section has a distinct job. Stable headings help humans maintain the file and help agents retrieve only the facts needed for the current task.</p>
    </div>
    <div class="context-anatomy-grid">
      {contextSections.map((section, index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{section.label}</h3>
          <p>{section.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section context-example-layout" id="annotated-example">
    <div class="context-example-copy">
      <p class="eyebrow">Annotated sample file</p>
      <h2>A complete structure can still be readable.</h2>
      <p>
        This fictional example shows the stable structure without exposing a real person's context. Color separates
        Markdown headings, the YAML quick reference, semantic fields, evidence comments, and ordinary supporting detail.
      </p>
      <ul>
        <li><strong>Blue headings</strong> create stable sections and semantic tags.</li>
        <li><strong>Green YAML keys</strong> form the fast, selective summary.</li>
        <li><strong>Gold fields</strong> highlight evidence, status, technologies, and constraints.</li>
        <li><strong>Muted comments</strong> mark private validation anchors and template notes.</li>
      </ul>
      <p class="context-privacy-note">
        Privacy boundary: the template is public and fictional. Your completed context file should remain private and should never be copied into this website.
      </p>
    </div>
    <div class="context-code-window">
      <div class="context-code-bar">
        <span></span><span></span><span></span>
        <code>sample-career-context.md</code>
      </div>
      <div class="context-code-legend" aria-label="Syntax color legend">
        <span class="legend-heading">Markdown sections</span>
        <span class="legend-yaml">YAML snapshot</span>
        <span class="legend-field">Evidence fields</span>
        <span class="legend-comment">Private comments</span>
      </div>
      <ContextCode source={sampleContext} />
    </div>
  </section>

  <section class="page-section context-usage-example">
    <div>
      <p class="eyebrow">Use it in a normal prompt</p>
      <h2>The file supplies context. Your prompt supplies the task.</h2>
    </div>
    <pre class="code-block"><code>Use the attached personal career context file.
Use the agentkit-seo-github skill to review my GitHub profile.
Tell me what to change first and do not add claims that are not in the file.</code></pre>
    <p>
      The context file does not publish or optimize anything by itself. It supplies the factual layer; the selected
      platform skill supplies the rules for a CV, LinkedIn profile, GitHub profile, portfolio, application answer,
      interview preparation, or another career task.
    </p>
    <div class="actions">
      <a class="button primary" href="/docs/usage/">Continue to the usage guide</a>
      <a class="button secondary" href="/playbooks/agent-context-optimization/">Build your own context file</a>
    </div>
  </section>
</BaseLayout>
