---
import DocsHub from "@components/docs/DocsHub.astro";
import PageHero from "@components/shared/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, webPageJsonLd } from "@data/metadata";
import "@styles/pages/docs.css";

const meta = {
  title: "Documentation",
  description: "Learn how VitaeContext stores reusable career context, applies focused skills, installs into supported agents, and uses VitaeGraph for deeper records.",
  path: "/docs/",
  type: "website" as const,
};
---

<BaseLayout meta={meta} jsonLd={[webPageJsonLd(meta.title, meta.description, meta.path, "CollectionPage"), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Docs", path: "/docs/" }])]}>
  <PageHero eyebrow="Documentation" title="Start with the part you need." text="Learn the workflow, install the skills, or look up one command. Each section stays focused." compact />
  <DocsHub />
</BaseLayout>
