---
import BaseLayout from "@layouts/BaseLayout.astro";
import { articleJsonLd, breadcrumbJsonLd } from "@data/metadata";

const meta = {
  title: "Docs",
  description:
    "AgentKit SEO documentation for reading the knowledge hub, installing the agent skills, creating context files, and improving LinkedIn, GitHub, CV, portfolio, and X profiles.",
  path: "/docs/",
  type: "article" as const,
};
---

<BaseLayout meta={meta} jsonLd={[articleJsonLd(meta.title, meta.description, meta.path), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Docs", path: "/docs/" }])]}>
  <section class="page-hero">
    <div class="inner">
      <p class="eyebrow">Documentation</p>
      <h1>Docs</h1>
      <p>Use AgentKit SEO as a readable professional profile optimization hub, an installable agent skill bundle, or both.</p>
    </div>
  </section>
  <section class="page-section">
    <div class="grid">
      <a class="doc-link" href="/docs/installation/">
        <h2>Installation</h2>
        <p>Install from a local checkout and choose a supported provider target.</p>
      </a>
      <a class="doc-link" href="/docs/usage/">
        <h2>Usage</h2>
        <p>Start with a context file, then route CV, GitHub, LinkedIn, portfolio, or X work to the matching skill.</p>
      </a>
      <a class="doc-link" href="/skills/linkedin/">
        <h2>LinkedIn optimization</h2>
        <p>Improve profile headline, About, Experience, Featured, Skills, recruiter search visibility, and AI-readable structure.</p>
      </a>
      <a class="doc-link" href="/skills/cv-ats/">
        <h2>CV and ATS optimization</h2>
        <p>Build parser-safe resume structure, align keywords, and rewrite bullets around verified achievements.</p>
      </a>
      <a class="doc-link" href="/skills/github/">
        <h2>GitHub SEO</h2>
        <p>Make profiles and repositories easier to search, inspect, understand, and trust.</p>
      </a>
      <a class="doc-link" href="/skills/web-portfolio/">
        <h2>Portfolio SEO</h2>
        <p>Check crawlability, metadata, structured data, sitemap coverage, JavaScript rendering, and AI retrieval signals.</p>
      </a>
      <a class="doc-link" href="/providers/">
        <h2>Providers</h2>
        <p>Compare Codex, Claude Code, Gemini CLI, OpenCode, and shared bundle invocation styles.</p>
      </a>
    </div>
  </section>
</BaseLayout>
