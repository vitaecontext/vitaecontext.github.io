---
import BaseLayout from "@layouts/BaseLayout.astro";
import { articleJsonLd, breadcrumbJsonLd } from "@data/metadata";
import { marketplace, providers, site } from "@data/site";

const meta = {
  title: "Installation | npm Package for AI Career Skills",
  description:
    "Install AgentKit SEO from npm, GitHub, or the Claude Code plugin marketplace for Codex, Claude Code, Gemini CLI, Antigravity, OpenCode, or a shared portable skill bundle.",
  path: "/docs/installation/",
  type: "article" as const,
};
---

<BaseLayout meta={meta} jsonLd={[articleJsonLd(meta.title, meta.description, meta.path), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Docs", path: "/docs/" }, { name: "Installation", path: "/docs/installation/" }])]}>
  <section class="page-hero">
    <div class="inner">
      <p class="eyebrow">Agent skills - install guide</p>
      <h1>Installation</h1>
      <p>Three ways to install AgentKit SEO skills into a supported agent environment. Choose the method that matches your setup.</p>
    </div>
  </section>

  <section class="page-section prose install-page">

    <div class="install-note">
      <p>
        <strong>Reading the docs without installing?</strong> Every skill page is a human-readable guide you can follow
        directly - no install required. Installation is only needed if you want an agent to load and invoke the skills.
      </p>
      <a class="button secondary" href="/skills/">Browse skill playbooks</a>
    </div>

    <!-- ── Method 1: npx ────────────────────────────────────────────────── -->
    <h2>Method 1 - <code>npx</code> <span class="install-status install-status--ready">Available</span></h2>
    <p>
      The canonical one-line install uses the published npm package:
    </p>
    <pre class="code-block"><code>npx agentkit-seo install --provider codex</code></pre>
    <p>
      Replace <code>codex</code> with any supported provider value. The package name is <code>agentkit-seo</code>
      and the binary is the same name.
    </p>
    <p>
      You can also run it directly from the GitHub repository:
    </p>
    <pre class="code-block"><code>npx github:agentkit-seo/agentkit-seo install --provider codex</code></pre>

    <!-- ── Method 2: Claude Code plugin marketplace ──────────────────────── -->
    <h2>Method 2 - Claude Code plugin marketplace <span class="install-status install-status--ready">Available</span></h2>
    <p>
      In Claude Code, the skills are also distributed through the plugin marketplace, so you can add and install them
      without the npm CLI:
    </p>
    <pre class="code-block"><code>{marketplace.addCommand}
{marketplace.installCommand}</code></pre>

    <!-- ── Method 3: local checkout ──────────────────────────────────────── -->
    <h2>Method 3 - local checkout <span class="install-status install-status--ready">Maintainers</span></h2>
    <p>
      Clone the repository, then invoke the CLI directly using <code>npx .</code> from the repo root.
      This is useful for maintainers testing unpublished changes.
    </p>
    <pre class="code-block"><code># Clone the repo
git clone https://github.com/agentkit-seo/agentkit-seo.git
cd agentkit-seo

# Install to the global default path for your provider
npx . install --provider codex

# Or install into a specific project directory
npx . install --provider codex --project-root /path/to/project</code></pre>

    <!-- ── Method 4: npm exec project-local ─────────────────────────────── -->
    <h2>Method 4 - project-local via <code>npm exec</code> <span class="install-status install-status--ready">Works now</span></h2>
    <p>
      If you have the repository checked out and want to preview generated provider files
      inside a specific project root without a global install:
    </p>
    <pre class="code-block"><code>npm exec --package ./. -- agentkit-seo install \
  --provider codex \
  --project-root .</code></pre>

    <!-- ── Supported providers ───────────────────────────────────────────── -->
    <h2>Supported providers</h2>
    <p>Pass one of the following values to <code>--provider</code>:</p>

    <div class="install-provider-table">
      {providers.map((p) => (
        <div class="install-provider-row">
          <div class="install-provider-meta">
            <strong>{p.name}</strong>
            <code class="install-target-path">{p.globalTarget}</code>
          </div>
          <div class="install-provider-commands">
            <p class="install-inv-label">Install command</p>
            <pre class="code-block code-block--sm"><code>{p.installCmd}</code></pre>
            <p class="install-inv-label">Invocation</p>
            <pre class="code-block code-block--sm code-block--muted"><code>{p.invocation}</code></pre>
            {p.invocationNote && <p class="install-provider-note">{p.invocationNote}</p>}
          </div>
        </div>
      ))}
    </div>

    <!-- ── Optional flags ────────────────────────────────────────────────── -->
    <h2>Optional flags</h2>
    <div class="install-flags-table">
      <div class="install-flag-row">
        <code>--project-root &lt;dir&gt;</code>
        <p>Install into a project-relative path instead of the global default.</p>
      </div>
      <div class="install-flag-row">
        <code>--target-dir &lt;dir&gt;</code>
        <p>Install skill folders into an exact directory. Overrides <code>--project-root</code> for skill placement. Required for <code>shared</code>.</p>
      </div>
      <div class="install-flag-row">
        <code>--commands-target-dir &lt;dir&gt;</code>
        <p>Override the install path for command wrapper files (OpenCode and Gemini CLI only).</p>
      </div>
      <div class="install-flag-row">
        <code>--force</code>
        <p>Replace existing skill folders and provider files without prompting.</p>
      </div>
    </div>

    <!-- ── After installation ────────────────────────────────────────────── -->
    <h2>After installation</h2>
    <p>
      Invoke one focused skill by name, provide the private context file path when available, and ask for a specific
      output: profile audit, rewrite plan, repository checklist, ATS-safe CV pass, metadata review, or maintenance
      checklist. See the <a href="/docs/usage/">usage guide</a> and the <a href="/providers/">providers page</a> for
      exact invocation syntax per environment, and the <a href="/docs/cli/">CLI reference</a> for every
      <code>agentkit-seo</code> command including <code>update</code>, <code>doctor</code>, <code>uninstall</code>, and
      <code>list</code>.
    </p>

    <p class="service-note">
      Source repository: <a href={site.repoUrl}>{site.repoUrl}</a>
    </p>
  </section>
</BaseLayout>
