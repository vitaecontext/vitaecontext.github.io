  },
  "Claude Code": {
    color: "#d97757",
    logoSvg: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="24" rx="4" fill="#D97757"/><path fill-rule="evenodd" clip-rule="evenodd" d="M11.9997 4C14.218 4 16.2255 4.89886 17.6566 6.33011C19.0877 7.76135 19.9866 9.76885 19.9866 11.9871C19.9866 14.2054 19.0877 16.2129 17.6566 17.6441C16.2255 19.0754 14.218 19.9742 11.9997 19.9742C9.78144 19.9742 7.77394 19.0754 6.3427 17.6441C4.91145 16.2129 4.01258 14.2054 4.01258 11.9871C4.01258 9.76885 4.91145 7.76135 6.3427 6.33011C7.77394 4.89886 9.78144 4 11.9997 4ZM7.99042 11.9871C7.99042 14.1989 9.78284 15.9913 11.9947 15.9913C14.2065 15.9913 15.999 14.1989 15.999 11.9871C15.999 9.7753 14.2065 7.98288 11.9947 7.98288C9.78284 7.98288 7.99042 9.7753 7.99042 11.9871Z" fill="#F0EBE1"/></svg>`,
  },
  "Gemini CLI": {
    color: "#4285f4",
    logoSvg: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs><linearGradient id="geminiGrad" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#4285F4"/><stop offset="33%" stop-color="#9B72CB"/><stop offset="66%" stop-color="#D96570"/><stop offset="100%" stop-color="#F49C52"/></linearGradient></defs><path d="M12 1.5C12 7.299 16.701 12 22.5 12 16.701 12 12 16.701 12 22.5 12 16.701 7.299 12 1.5 12 7.299 12 12 7.299 12 1.5z" fill="url(#geminiGrad)"/></svg>`,
