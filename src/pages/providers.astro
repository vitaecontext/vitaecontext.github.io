  "OpenCode": {
    color: "#7c3aed",
    logoSvg: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs><linearGradient id="opencodeGrad" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#7C3AED"/><stop offset="100%" stop-color="#3B82F6"/></linearGradient></defs><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12C2 16.42 4.87 20.17 8.84 21.5C9.34 21.58 9.5 21.27 9.5 21.01C9.5 20.77 9.49 20.14 9.48 19.31C6.7 19.91 6.11 17.97 6.11 17.97C5.66 16.81 5.01 16.5 5.01 16.5C4.1 15.88 5.08 15.89 5.08 15.89C6.08 15.96 6.61 16.92 6.61 16.92C7.5 18.43 8.93 18 9.5 17.77C9.59 17.13 9.85 16.69 10.14 16.44C7.92 16.19 5.59 15.33 5.59 11.47C5.59 10.37 5.98 9.47 6.63 8.76C6.52 8.5 6.18 7.48 6.73 6.1C6.73 6.1 7.57 5.83 9.48 7.12C10.28 6.9 11.14 6.79 12 6.79C12.86 6.79 13.72 6.9 14.52 7.12C16.43 5.83 17.27 6.1 17.27 6.1C17.82 7.48 17.48 8.5 17.37 8.76C18.02 9.47 18.41 10.37 18.41 11.47C18.41 15.34 16.07 16.19 13.85 16.43C14.2 16.73 14.51 17.33 14.51 18.25C14.51 19.56 14.5 20.62 14.5 21.01C14.5 21.28 14.66 21.59 15.17 21.5C19.13 20.16 22 16.42 22 12C22 6.477 17.523 2 12 2Z" fill="url(#opencodeGrad)"/></svg>`,
  },
  "Shared bundle": {
    color: "#243d32",
    logoSvg: `<svg viewBox="0 0 24 24" fill="#243d32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>`,
  },
