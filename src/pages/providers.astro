---
import BaseLayout from "@layouts/BaseLayout.astro";
import { articleJsonLd, breadcrumbJsonLd } from "@data/metadata";
import { providers, site } from "@data/site";

const meta = {
  title: "Providers",
  description:
    "AgentKit SEO provider support for Codex, Claude Code, Gemini CLI, OpenCode, and shared portable skill bundles. Copy-paste install commands for each environment.",
  path: "/providers/",
  type: "article" as const,
};

