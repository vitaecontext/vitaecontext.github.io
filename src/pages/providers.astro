---
import PlatformIcon from "@components/PlatformIcon.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, webPageJsonLd } from "@data/metadata";
import { marketplace, providers, site } from "@data/site";

const meta = {
  title: "Supported Providers – Codex, Claude Code, Gemini CLI, Antigravity, OpenCode",
  description:
    "Install AgentKit SEO agent skills into Codex (OpenAI), Claude Code (Anthropic), Gemini CLI (Google), Antigravity, OpenCode, or a shared portable bundle. One CLI, six supported AI agent environments, plus a Claude Code plugin marketplace. Copy-paste npx install commands for each.",
  path: "/providers/",
  type: "website" as const,
};

const providerMeta: Record<string, { icon: string; owner: string }> = {
  "Codex": { icon: "openai", owner: "OpenAI" },
  "Claude Code": { icon: "anthropic", owner: "Anthropic" },
  "Gemini CLI": { icon: "gemini", owner: "Google Gemini" },
  "Antigravity": { icon: "gemini", owner: "Antigravity CLI" },
  "OpenCode": { icon: "opencode", owner: "OpenCode" },
  "Shared bundle": { icon: "package", owner: "Portable export" },
};

---

<BaseLayout meta={meta} jsonLd={[webPageJsonLd(meta.title, meta.description, meta.path, "CollectionPage"), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Providers", path: "/providers/" }])]}>
  <section class="page-hero">
    <div class="inner">
      <p class="eyebrow">Provider support</p>
      <h1>Providers</h1>
      <p>One install CLI, six supported environments, plus a Claude Code plugin marketplace. Choose your provider and copy the install command below.</p>
    </div>
  </section>

  <section class="page-section">

    <!-- Install method note -->
    <div class="providers-install-note">
      <div class="providers-install-methods">
        <div class="providers-install-method">
          <span class="install-status install-status--ready">Available</span>
          <p class="providers-install-method-label">Via npm</p>
          <pre class="code-block code-block--sm"><code>npx agentkit-seo install --provider &lt;provider&gt;</code></pre>
        </div>
        <div class="providers-install-method-sep" aria-hidden="true">or</div>
        <div class="providers-install-method">
          <span class="install-status install-status--ready">Maintainers</span>
          <p class="providers-install-method-label">From a local checkout</p>
          <pre class="code-block code-block--sm"><code>npx . install --provider &lt;provider&gt;</code></pre>
        </div>
      </div>
      <p class="providers-install-hint">
        See the <a href="/docs/installation/">installation guide</a> for clone instructions, project-local install,
        and all available flags.
      </p>
    </div>

    <!-- Claude Code plugin marketplace -->
    <div class="providers-install-note" style="margin-top:2rem;">
      <div class="providers-install-method">
        <span class="install-status install-status--ready">Claude Code</span>
        <p class="providers-install-method-label">Plugin marketplace</p>
        <pre class="code-block code-block--sm"><code>{marketplace.addCommand}
{marketplace.installCommand}</code></pre>
      </div>
      <p class="providers-install-hint">
        Claude Code users can also add and install the skills through the plugin marketplace, as an alternative to the
        <code>--provider claude-code</code> CLI install.
      </p>
    </div>

    <!-- Provider cards -->
    <div class="section-header" style="margin-top:2rem;">
      <p class="eyebrow">Install targets</p>
      <h2>One methodology, six environments.</h2>
    </div>

    <div class="provider-card-grid">
      {providers.map((provider) => {
        const pm = providerMeta[provider.name];
        return (
          <article class="provider-card">
            <div class="provider-card-top">
              <div class={`provider-logo provider-logo--${pm?.icon ?? "package"}`} aria-hidden="true">
                <PlatformIcon kind={pm?.icon ?? "package"} />
              </div>
              <div class="provider-header">
                <span class="provider-status">{provider.status}</span>
                <h2 class="provider-name">{provider.name}</h2>
                {pm?.owner && <span class="provider-owner">{pm.owner}</span>}
              </div>
            </div>

            <p class="provider-summary">{provider.summary}</p>

            <div class="provider-install-block">
              <p class="provider-inv-label">Install from npm</p>
              <pre class="code-block code-block--sm provider-copyable"><code>{provider.installCmd}</code></pre>
            </div>

            <div class="provider-invocation">
              <span class="provider-inv-label">Invocation example</span>
              <pre class="code-block code-block--sm code-block--muted"><code>{provider.invocation}</code></pre>
              {provider.invocationNote && <p class="install-provider-note">{provider.invocationNote}</p>}
            </div>

            <div class="provider-target-row">
              <span class="provider-inv-label">Default install path</span>
              <code class="provider-target-path">{provider.globalTarget}</code>
            </div>
          </article>
        );
      })}
    </div>

    <p class="service-note">
      {site.disclaimer} Repository: <a href={site.repoUrl}>{site.repoUrl}</a>
    </p>
  </section>
</BaseLayout>
