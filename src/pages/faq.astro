---
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, faqJsonLd, webPageJsonLd } from "@data/metadata";
import { site } from "@data/site-config";
import "@styles/pages/faq.css";

const meta = {
  title: "VitaeContext FAQ",
  description:
    "Answers about VitaeContext, Career Context, supported providers, installation, VitaeGraph, privacy, evidence, and project limitations.",
  path: "/faq/",
  type: "website" as const,
  image: "/og/faq.png",
};

// Each entry drives both the visible accordion and the FAQPage structured data,
// so the two never drift. Answers stay honest and avoid ranking promises.
const faqs = [
  {
    question: "What is VitaeContext?",
    answer:
      "VitaeContext is open-source career-context infrastructure for AI agents and career systems. It helps a person build and maintain private, reusable Career Context in Markdown, then makes selected context available to downstream tools.",
  },
  {
    question: "Does VitaeContext write CVs or optimize profiles?",
    answer:
      "Not by itself. VitaeContext supplies the grounded context layer before those tasks. A downstream agent, CV builder, application workflow, or profile tool uses the Career Context and applies its own task-specific method.",
  },
  {
    question: "Which agents and providers does it support?",
    answer:
      "11 install targets: Codex, Claude Code, Cursor, Windsurf (Cascade), Roo Code / Cline, Gemini CLI, Antigravity, OpenCode, IBM Bob (watsonx), xAI Grok, and a portable shared bundle. In Claude Code the skills are also available through the plugin marketplace, and tools supporting Model Context Protocol can connect via stdio.",
  },
  {
    question: "What is the Model Context Protocol (MCP) server?",
    answer:
      "VitaeContext includes a native, zero-dependency MCP server conforming to protocol version 2024-11-05. Compatible agents can query selected local Career Context and VitaeGraph records without copying those files into every project workspace.",
  },
  {
    question: "How do I install it?",
    answer:
      "Run npx vitaecontext install --provider <provider> with one of the supported provider values, or run the stateless MCP server with npx -y vitaecontext mcp. In Claude Code you can also add the plugin marketplace with /plugin marketplace add vitaecontext/vitaecontext and /plugin install vitaecontext@vitaecontext. See the installation guide and CLI reference for every command and flag.",
  },
  {
    question: "What is Career Context?",
    answer:
      "Career Context is a user-owned, maintained Markdown record for one person's supplied career facts, roles, projects, evidence links, constraints, claims to avoid, and goals recorded as stated intent. Downstream agents can read the relevant parts so work starts from the same inspectable source.",
  },
  {
    question: "What is VitaeGraph?",
    answer:
      "VitaeGraph is VitaeContext's optional deeper layer for local Markdown records such as education, thesis work, courses, projects, experience, certifications, awards, and publications. It complements compact Career Context instead of replacing it; its validation checks structure rather than authenticating claims.",
  },
  {
    question: "Which runtime skills are included?",
    answer:
      "Three: the root vitaecontext router, vitaecontext-build for compact Career Context, and vitaecontext-vitaegraph for optional deeper records. Version 2.3 removed the former CV, LinkedIn, GitHub, portfolio, and X adaptation modules.",
  },
  {
    question: "Is VitaeContext affiliated with career platforms or AI providers?",
    answer:
      "No. Platform names, trademarks, and logos belong to their respective owners. VitaeContext is independent and is not affiliated with, sponsored by, or endorsed by those platforms.",
  },
  {
    question: "Does it collect my data?",
    answer:
      "VitaeContext is a set of Markdown skill files and a local CLI with no backend, so the project itself collects nothing. Your context file is a private local file you control. How any individual agent or provider handles the content you give it is governed by that provider, not by VitaeContext.",
  },
  {
    question: "Does it verify every career claim?",
    answer:
      "No. VitaeContext keeps supplied facts, evidence links, stated intent, and unresolved claims visibly separate. Validation checks the artifact's structure and internal consistency, not the truth of every real-world claim.",
  },
];
---

<BaseLayout meta={meta} jsonLd={[webPageJsonLd(meta.title, meta.description, meta.path), faqJsonLd(faqs), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "FAQ", path: "/faq/" }])]}>
  <section class="page-hero faq-hero">
    <div class="inner">
      <p class="eyebrow">Questions and answers</p>
      <h1>Frequently asked questions</h1>
      <p>What VitaeContext is, how to install it, and what it deliberately does not promise.</p>
    </div>
  </section>

  <section class="page-section faq-section">
    <div class="faq-list">
      {faqs.map((item, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>
            <span class="faq-question">{item.question}</span>
            <span class="faq-marker" aria-hidden="true"></span>
          </summary>
          <p class="faq-answer">{item.answer}</p>
        </details>
      ))}
    </div>

    <p class="service-note">
      Still have a question? Open an issue on the <a href={site.repoUrl}>source repository</a> or see the
      <a href="/docs/">documentation</a>.
    </p>
  </section>
</BaseLayout>
