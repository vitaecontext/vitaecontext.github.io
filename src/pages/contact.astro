---
import BaseLayout from "@layouts/BaseLayout.astro";
import { articleJsonLd, breadcrumbJsonLd } from "@data/metadata";
import { site } from "@data/site";

const meta = {
  title: "Contact",
  description:
    "Contact and contribution paths for AgentKit SEO, including GitHub-based project discovery and maintainer attribution.",
  path: "/contact/",
  type: "article" as const,
};

const authorRoles: Record<string, string> = {
  "Renato Mignone": "Co-creator & maintainer",
  "Elia Innocenti": "Co-creator & maintainer",
};

const authorAvatarInitials: Record<string, string> = {
  "Renato Mignone": "RM",
  "Elia Innocenti": "EI",
};

const authorColors: Record<string, string> = {
  "Renato Mignone": "teal",
  "Elia Innocenti": "coral",
};
---

<BaseLayout meta={meta} jsonLd={[articleJsonLd(meta.title, meta.description, meta.path), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Contact", path: "/contact/" }])]}>
  <section class="page-hero">
    <div class="inner">
      <p class="eyebrow">Contact</p>
      <h1>Contact</h1>
      <p>AgentKit SEO is maintained by Renato Mignone and Elia Innocenti. Use the source repository and public author profiles to inspect the work, follow updates, or get in touch.</p>
    </div>
  </section>

  <section class="page-section contact-section">
    <div class="contact-author-grid">
      {site.authors.map((author) => (
        <article class={`contact-author-card contact-author-card--${authorColors[author.name] ?? "teal"}`}>
          <div class="contact-author-avatar" aria-hidden="true">
            {authorAvatarInitials[author.name] ?? author.name.slice(0, 2)}
          </div>
          <div class="contact-author-body">
            <p class="contact-author-role eyebrow">{authorRoles[author.name] ?? "Maintainer"}</p>
            <h2 class="contact-author-name">{author.name}</h2>
            <div class="contact-author-actions">
              <a class="contact-btn contact-btn--github" href={author.github} target="_blank" rel="noreferrer">
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                </svg>
                GitHub
              </a>
              <a class="contact-btn contact-btn--linkedin" href={author.linkedin} target="_blank" rel="noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
                LinkedIn
              </a>
              <a class="contact-btn contact-btn--portfolio" href={author.portfolio} target="_blank" rel="noreferrer">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <circle cx="10" cy="10" r="8" />
                  <path d="M2 10h16M10 2a13 13 0 0 1 0 16M10 2a13 13 0 0 0 0 16" />
                </svg>
                Portfolio
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="contact-project-card">
      <div class="contact-project-inner">
        <div class="contact-project-copy">
          <p class="eyebrow">Project repository</p>
          <h2 class="contact-project-title">Source on GitHub</h2>
          <p>Inspect the methodology, open issues, submit PRs, or follow updates directly from the project repository.</p>
        </div>
        <a class="contact-btn contact-btn--github contact-btn--large" href={site.repoUrl} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
          View repository
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
