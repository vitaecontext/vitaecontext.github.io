---
import GuideCatalog from "@components/guides/GuideCatalog.astro";
import PageHero from "@components/shared/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, webPageJsonLd } from "@data/metadata";
import "@styles/pages/catalog.css";

const meta = {
  title: "Guides",
  description: "Human-readable VitaeContext guides for reusable career context, VitaeGraph, CV and ATS, LinkedIn, GitHub, portfolios, and X.",
  path: "/playbooks/",
  type: "website" as const,
};
---

<BaseLayout meta={meta} jsonLd={[webPageJsonLd(meta.title, meta.description, meta.path, "CollectionPage"), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Guides", path: "/playbooks/" }])]}>
  <PageHero eyebrow="Guides" title="The methods behind the skills." text="Read practical guidance for organizing career context and working on one professional surface at a time." actions={[{ label: "Browse agent skills", href: "/skills/", tone: "primary" }]} />
  <GuideCatalog />
</BaseLayout>
