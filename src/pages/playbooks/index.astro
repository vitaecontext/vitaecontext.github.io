---
import GuideCatalog from "@components/guides/GuideCatalog.astro";
import PageHero from "@components/shared/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, webPageJsonLd } from "@data/metadata";
import "@styles/pages/catalog.css";

const meta = {
  title: "Career Context Guide",
  description: "The human-readable method for building and maintaining reusable, evidence-bounded Career Context.",
  path: "/playbooks/",
  type: "website" as const,
};
---

<BaseLayout meta={meta} jsonLd={[webPageJsonLd(meta.title, meta.description, meta.path, "CollectionPage"), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Guides", path: "/playbooks/" }])]}>
  <PageHero eyebrow="Guide" title="Build the context layer." text="Read the maintained method for turning selected career material into a compact source of truth for downstream AI work." actions={[{ label: "Read Context Builder", href: "/playbooks/context-builder/", tone: "primary" }, { label: "See how it works", href: "/docs/usage/" }]} />
  <GuideCatalog />
</BaseLayout>
