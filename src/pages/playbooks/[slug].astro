---
import { getCollection, render } from "astro:content";
import GuideOverview from "@components/guides/GuideOverview.astro";
import PageHero from "@components/shared/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { articleJsonLd, breadcrumbJsonLd } from "@data/metadata";
import { skills } from "@data/skills";
import "@styles/pages/catalog.css";

export async function getStaticPaths() {
  const entries = await getCollection("playbooks");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const slug = entry.id;
const { Content, headings } = await render(entry);
const skill = skills.find((item) => item.slug === slug);
const sectionHeadings = headings
  .filter((heading) => heading.depth === 2 && heading.slug.startsWith("section-"))
  .map((heading) => ({ ...heading, text: heading.text.replace(/^Section:\s*/i, "") }));
const meta = {
  title: entry.data.title ?? skill?.name ?? slug,
  description: skill?.summary ?? "AgentKit SEO guide",
  path: `/playbooks/${slug}/`,
  type: "article" as const,
  image: skill?.ogImage ?? `/og/playbooks/${slug}.png`,
  datePublished: entry.data.published ?? entry.data.last_updated,
  dateModified: entry.data.last_updated,
  keywords: entry.data.tags,
};
---

<BaseLayout meta={meta} jsonLd={[articleJsonLd(meta.title, meta.description, meta.path, { image: meta.image, datePublished: meta.datePublished, dateModified: meta.dateModified, keywords: meta.keywords }), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Guides", path: "/playbooks/" }, { name: meta.title, path: meta.path }])]}>
  <PageHero eyebrow="Guide" title={meta.title} text={meta.description} actions={skill ? [{ label: "Use as agent skill", href: `/skills/${slug}/`, tone: "primary" }, { label: "All guides", href: "/playbooks/" }] : [{ label: "All guides", href: "/playbooks/" }]} compact />
  <GuideOverview skill={skill} headings={sectionHeadings} updated={meta.dateModified}><Content /></GuideOverview>
</BaseLayout>
