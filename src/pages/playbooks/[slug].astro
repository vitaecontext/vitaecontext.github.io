---
import { getCollection } from 'astro:content';
import BaseLayout from "@layouts/BaseLayout.astro";
import { articleJsonLd, breadcrumbJsonLd } from "@data/metadata";
import { skills } from "@data/site";

export async function getStaticPaths() {
  const playbookEntries = await getCollection('playbooks');
  return playbookEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const skillData = skills.find(s => s.slug === entry.slug);

const meta = {
  title: skillData?.metaTitle ?? entry.data.title ?? skillData?.name ?? entry.slug,
  description: skillData?.metaDescription ?? skillData?.summary ?? "AgentKit SEO Methodology Playbook",
  path: `/playbooks/${entry.slug}/`,
  type: "article" as const,
};
---

<BaseLayout meta={meta} jsonLd={[articleJsonLd(meta.title, meta.description, meta.path), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Playbooks", path: "/playbooks/" }, { name: meta.title, path: meta.path }])]}>
  <section class="page-hero">
    <div class="inner">
      <div class="docs-mode-label-row" style="margin-bottom: 1rem;">
        <span class="mode-badge mode-badge--read">Playbook</span>
        <a href={`/skills/${entry.slug}/`} class="mode-badge mode-badge--agent" style="text-decoration: none; background: transparent; border: 1px solid var(--line); color: var(--muted); opacity: 0.7; transition: opacity 0.2s;">Switch to Agent Skill →</a>
      </div>
      <p class="eyebrow">Methodology</p>
      <h1>{meta.title}</h1>
      <p>{meta.description}</p>
      {skillData && <p class="search-intent">Covers: {skillData.searchIntent}</p>}
    </div>
  </section>

  <section class="page-section">
    <article class="prose">
      <Content />
    </article>
  </section>
</BaseLayout>
