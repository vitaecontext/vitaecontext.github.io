---
import { getCollection } from 'astro:content';
import BaseLayout from "@layouts/BaseLayout.astro";
import { articleJsonLd, breadcrumbJsonLd } from "@data/metadata";
import { skills } from "@data/site";

export async function getStaticPaths() {
  const playbookEntries = await getCollection('playbooks');
  return playbookEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const skillData = skills.find(s => s.slug === entry.slug);
const questions = skillData?.questions ?? [];
const sectionHeadings = headings
  .filter((heading) => heading.depth === 2 && heading.slug.startsWith("section-"))
  .map((heading) => ({
    ...heading,
    text: heading.text.replace(/^Section:\s*/i, ""),
  }));
const meta = {
  title: skillData?.metaTitle ?? entry.data.title ?? skillData?.name ?? entry.slug,
  description: skillData?.metaDescription ?? skillData?.summary ?? "AgentKit SEO Methodology Playbook",
  path: `/playbooks/${entry.slug}/`,
  type: "article" as const,
  image: skillData?.ogImage ?? `/og/playbooks/${entry.slug}.png`,
  datePublished: entry.data.published ?? entry.data.last_updated,
  dateModified: entry.data.last_updated,
  keywords: entry.data.tags,
};
const formattedUpdatedDate = meta.dateModified
  ? new Intl.DateTimeFormat("en", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(meta.dateModified))
  : undefined;
---

<BaseLayout meta={meta} jsonLd={[
  articleJsonLd(meta.title, meta.description, meta.path, {
    image: meta.image,
    datePublished: meta.datePublished,
    dateModified: meta.dateModified,
    keywords: meta.keywords,
  }),
  breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Playbooks", path: "/playbooks/" }, { name: meta.title, path: meta.path }]),
]}>
  <section class="page-hero playbook-hero-v2">
    <div class="inner">
      <div class="playbook-hero-grid">
        <div class="playbook-hero-title">
          <p class="eyebrow">Methodology playbook</p>
          <h1>{meta.title}</h1>
        </div>
        <aside class="playbook-hero-summary" aria-label={`${meta.title} summary`}>
          <div class="playbook-hero-actions">
            <span class="mode-badge mode-badge--read">Playbook</span>
            <a href={`/skills/${entry.slug}/`} class="button secondary">Agent skill</a>
          </div>
          <p>{meta.description}</p>
          {meta.dateModified && formattedUpdatedDate && (
            <p class="playbook-updated">
              Updated <time datetime={meta.dateModified}>{formattedUpdatedDate}</time>
            </p>
          )}
          <p class="playbook-byline">Maintained by Renato Mignone and Elia Innocenti · Source-aware guidance</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="page-section playbook-quick" aria-labelledby="quick-guide-heading">
    <div class="playbook-quick-head">
      <p class="eyebrow">Five-minute guide</p>
      <h2 id="quick-guide-heading">Start with the decisions that matter.</h2>
      <p>This short guide gives you the useful path first. The complete reference continues below, already open for deeper work and source review.</p>
    </div>
    <div class="playbook-quick-grid">
      <article>
        <span class="quick-card-number">01</span>
        <h3>Use this when</h3>
        <ul>
          {skillData?.useWhen.slice(0, 3).map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article>
        <span class="quick-card-number">02</span>
        <h3>What the method does</h3>
        <ol>
          {skillData?.method.slice(0, 3).map((item) => <li>{item}</li>)}
        </ol>
      </article>
      <article>
        <span class="quick-card-number">03</span>
        <h3>What you get</h3>
        <ul class="quick-output-list">
          {skillData?.outputs.map((item) => <li>{item}</li>)}
        </ul>
        <a href={`/skills/${entry.slug}/`} class="text-link">Run this as an agent skill →</a>
      </article>
    </div>
  </section>

  {questions.length > 0 && (
    <section class="page-section" aria-labelledby="questions-heading">
      <div class="playbook-quick-head">
        <p class="eyebrow">Search and answer coverage</p>
        <h2 id="questions-heading">Questions this {(skillData?.shortName ?? "methodology").toLowerCase()} guide answers</h2>
        <p>Use the complete reference below for the constraints, examples, evidence rules, and implementation details behind each answer.</p>
      </div>
      <ul class="playbook-question-list">
        {questions.map((question) => <li>{question}</li>)}
      </ul>
    </section>
  )}

  <section class="page-section playbook-reference-section">
    <details class="playbook-reference" open>
      <summary>
        <span>
          <small>Complete reference</small>
          <strong>{skillData?.shortName ?? "Methodology"} playbook</strong>
        </span>
        <span class="summary-action" aria-hidden="true">Show</span>
      </summary>
      <div class="playbook-reference-inner">
        {sectionHeadings.length > 0 && (
          <nav class="playbook-reference-toc" aria-label={`${meta.title} reference sections`}>
            <p>In this reference</p>
            {sectionHeadings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
          </nav>
        )}
        <article class="prose">
          <Content />
        </article>
      </div>
    </details>
  </section>
</BaseLayout>
