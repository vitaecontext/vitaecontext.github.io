---
import PageHero from "@components/shared/PageHero.astro";
import SkillDetail from "@components/skills/SkillDetail.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, softwareSourceCodeJsonLd } from "@data/metadata";
import { skills } from "@data/skills";
import "@styles/pages/catalog.css";

export function getStaticPaths() {
  return skills.map((skill) => ({ params: { slug: skill.slug }, props: { skill } }));
}

const { skill } = Astro.props;
const invocationName = skill.invocationName ?? `agentkit-seo-${skill.slug}`;
const meta = {
  title: `${skill.metaTitle ?? skill.name} Agent Skill`,
  description: skill.metaDescription ?? skill.summary,
  path: `/skills/${skill.slug}/`,
  type: "article" as const,
  image: skill.ogImage ?? `/og/skills/${skill.slug}.png`,
};
---

<BaseLayout meta={meta} jsonLd={[softwareSourceCodeJsonLd(meta.title, meta.description, meta.path, invocationName), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Skills", path: "/skills/" }, { name: skill.name, path: meta.path }])]}>
  <PageHero eyebrow="Agent skill" title={invocationName} text={skill.summary} actions={[{ label: "Install", href: "/docs/installation/", tone: "primary" }, { label: "Read the guide", href: `/playbooks/${skill.slug}/` }]} compact />
  <SkillDetail skill={skill} invocationName={invocationName} />
</BaseLayout>
