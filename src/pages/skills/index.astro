---
import SectionHeader from "@components/SectionHeader.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { articleJsonLd, breadcrumbJsonLd } from "@data/metadata";
import { skills } from "@data/site";

const meta = {
  title: "Skills",
  description:
    "Explore AgentKit SEO modules for LinkedIn profile optimization, GitHub SEO, CV/ATS resume optimization, portfolio SEO, X/Twitter strategy, and agent context files.",
  path: "/skills/",
  type: "article" as const,
};
---

<BaseLayout meta={meta} jsonLd={[articleJsonLd(meta.title, meta.description, meta.path), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Skills", path: "/skills/" }])]}>
  <section class="page-hero">
    <div class="inner">
      <p class="eyebrow">Skill library</p>
      <h1>Skills</h1>
      <p>Read the modules as human guides or install them as focused agent skills for professional profile optimization.</p>
    </div>
  </section>
  <section class="page-section">
    <SectionHeader title="Choose the surface you want to improve." />
    <div class="grid">
      {skills.map((skill) => (
        <a class="card" href={skill.href}>
          <span class="icon" aria-hidden="true">{skill.shortName.slice(0, 2)}</span>
          <h2>{skill.name}</h2>
          <p>{skill.summary}</p>
          <p class="search-intent">{skill.searchIntent}</p>
          <ul class="tag-list">
            {skill.outputs.map((output) => <li>{output}</li>)}
          </ul>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
