---
import PlatformIcon from "@components/PlatformIcon.astro";
import SectionHeader from "@components/SectionHeader.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { articleJsonLd, breadcrumbJsonLd } from "@data/metadata";
import { skills } from "@data/site";

const meta = {
  title: "Agent Skills for LinkedIn, GitHub, CV, Portfolio, and X SEO",
  description:
    "Install AgentKit SEO skills for LinkedIn profile optimization, GitHub SEO, ATS resume optimization, portfolio SEO, X/Twitter strategy, and AI career context files.",
  path: "/skills/",
  type: "article" as const,
};
---

<BaseLayout meta={meta} jsonLd={[articleJsonLd(meta.title, meta.description, meta.path), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Agent Skills", path: "/skills/" }])]}>
  <section class="page-hero">
    <div class="inner">
      <p class="eyebrow">Technical Packages</p>
      <h1>Agent Skills</h1>
      <p>Installable rule packages for LinkedIn profile optimization, GitHub SEO, ATS resume optimization, portfolio SEO, X/Twitter strategy, and agent context files. To read the human methodology instead, visit the <a href="/playbooks/">Playbooks Hub</a>.</p>
    </div>
  </section>

  <section class="page-section">
    <SectionHeader title="Choose an agent skill to install." />
    <div class="grid">
      {skills.map((skill) => (
        <a class="card skill-card" href={`/skills/${skill.slug}/`}>
          <div class="skill-card-top">
            <span class="icon" aria-hidden="true"><PlatformIcon kind={skill.icon} /></span>
            <div class="skill-card-modes" aria-label="Available as">
              <span class="skill-mode-tag skill-mode-tag--agent">Agent skill</span>
            </div>
          </div>
          <h2>agentkit-seo-{skill.slug}</h2>
          <p>{skill.summary}</p>
          <p class="search-intent" style="margin-top: 1rem;">{skill.searchIntent}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
