---
import PageHero from "@components/shared/PageHero.astro";
import SkillCatalog from "@components/skills/SkillCatalog.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, webPageJsonLd } from "@data/metadata";
import "@styles/pages/catalog.css";

const meta = {
  title: "Agent Skills",
  description: "The three VitaeContext runtime skills for routing, building compact Career Context, and maintaining deeper VitaeGraph records.",
  path: "/skills/",
  type: "website" as const,
};
---

<BaseLayout meta={meta} jsonLd={[webPageJsonLd(meta.title, meta.description, meta.path, "CollectionPage"), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Skills", path: "/skills/" }])]}>
  <PageHero eyebrow="Runtime surface" title="Three skills. One context layer." text="VitaeContext now focuses on building, maintaining, and retrieving career context. Downstream systems handle CVs, applications, profiles, and other career tasks." actions={[{ label: "Install VitaeContext", href: "/docs/installation/", tone: "primary" }, { label: "See how it works", href: "/docs/usage/" }]} />
  <SkillCatalog />
</BaseLayout>
