---
import BaseLayout from "@layouts/BaseLayout.astro";

const meta = {
  title: "Page Not Found",
  description: "The requested VitaeContext page was not found. Use the main navigation to reach skills, providers, docs, changelog, or contact.",
  path: "/404/",
  robots: "noindex, follow",
  canonical: false,
};
---

<BaseLayout meta={meta}>
  <section class="page-hero">
    <div class="inner">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p>This route is not part of the current VitaeContext website.</p>
      <div class="actions">
        <a class="button primary" href="/docs/">Read docs</a>
        <a class="button secondary" href="/skills/">Explore skills</a>
      </div>
    </div>
  </section>
</BaseLayout>
