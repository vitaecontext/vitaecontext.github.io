---
import BaseLayout from "@layouts/BaseLayout.astro";
import VitaeGraphHero from "@components/vitaegraph/VitaeGraphHero.astro";
import VitaeGraphRecords from "@components/vitaegraph/VitaeGraphRecords.astro";
import VitaeGraphRelationships from "@components/vitaegraph/VitaeGraphRelationships.astro";
import VitaeGraphRetrieval from "@components/vitaegraph/VitaeGraphRetrieval.astro";
import VitaeGraphStart from "@components/vitaegraph/VitaeGraphStart.astro";
import { articleJsonLd, breadcrumbJsonLd } from "@data/metadata";
import "@styles/pages/vitaegraph.css";

const meta = {
  title: "VitaeGraph | Connected Markdown Career Records",
  description:
    "Organize detailed projects, roles, education, thesis work, credentials, and their relationships as local Markdown records with rebuildable indexes.",
  path: "/vitaegraph/",
  type: "article" as const,
  image: "/og/vitaegraph.png",
  datePublished: "2026-07-07",
  dateModified: "2026-07-16",
  keywords: [
    "VitaeGraph",
    "career knowledge graph",
    "Markdown knowledge graph",
    "AI career context",
    "local-first agent skills",
  ],
};
---

<BaseLayout meta={meta} jsonLd={[
  articleJsonLd(meta.title, meta.description, meta.path, {
    image: meta.image,
    datePublished: meta.datePublished,
    dateModified: meta.dateModified,
    keywords: meta.keywords,
  }),
  breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "VitaeGraph", path: meta.path }]),
]}>
  <div class="vg-page">
    <VitaeGraphHero />
    <VitaeGraphRecords />
    <VitaeGraphRelationships />
    <VitaeGraphRetrieval />
    <VitaeGraphStart />
  </div>
</BaseLayout>
