---
import InfoCard from "@components/shared/InfoCard.astro";
import PageHero from "@components/shared/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, webPageJsonLd } from "@data/metadata";

const meta = { title: "Career Task and Workflow Chooser", description: "Choose a VitaeContext workflow for Career Context, CVs, profiles, repositories, portfolios, messages, interviews, and related professional tasks.", path: "/profile-optimization/", type: "website" as const };
---
<BaseLayout meta={meta} jsonLd={[webPageJsonLd(meta.title, meta.description, meta.path), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Career workflows", path: meta.path }])]}>
  <PageHero eyebrow="Career task chooser" title="Start from the task you need to do." text="This page routes a task to the right VitaeContext surface. Choose an installed skill when an agent should apply the method, a guide when you want to follow it yourself, or the usage guide when you first need Career Context." compact />
  <section class="page-section">
    <div class="card-grid card-grid--three">
      <InfoCard title="Use an agent skill" text="Choose an installable module for Career Context, a CV, LinkedIn, GitHub, a portfolio, X, or VitaeGraph." href="/skills/" label="Browse agent skills" />
      <InfoCard title="Read the method" text="Open the corresponding human-readable method without installing a runtime skill." href="/playbooks/" label="Browse human guides" />
      <InfoCard title="Build the shared input" text="Learn how Career Context differs from a résumé or provider memory, then use it for one focused task." href="/docs/usage/" label="Understand Career Context" />
    </div>
    <p class="service-note">For a first task, <a class="text-link" href="/playbooks/context-builder/">build and maintain Career Context</a>. For exact setup commands, use the <a class="text-link" href="/docs/installation/">installation guide</a>.</p>
  </section>
</BaseLayout>
