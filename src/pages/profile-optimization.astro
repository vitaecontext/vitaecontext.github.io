---
import PlatformIcon from "@components/PlatformIcon.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, webPageJsonLd } from "@data/metadata";
import { serviceMarks, site } from "@data/site";

const meta = {
  title: "Professional Profile Optimization with AI",
  description:
    "Choose an evidence-based workflow to optimize your LinkedIn, GitHub, ATS resume, web portfolio, X profile, reusable AI career context, or VitaeGraph records.",
  path: "/profile-optimization/",
  type: "website" as const,
};

const questions = [
  {
    question: "How can I optimize my LinkedIn profile?",
    answer:
      "Clarify the target role, use standard role and skill terms, rewrite the headline and About section around specific evidence, complete Experience and Skills, and connect claims to proof in Featured.",
    href: "/playbooks/linkedin/",
    label: "LinkedIn profile optimization playbook",
  },
  {
    question: "How can I improve my GitHub profile?",
    answer:
      "Make the bio and profile README explain your focus, choose pinned repositories that support it, and give each important repository a descriptive name, summary, topics, README, and proof of current status.",
    href: "/playbooks/github/",
    label: "GitHub profile and repository SEO playbook",
  },
  {
    question: "How can I make my resume ATS-friendly?",
    answer:
      "Use a simple parser-safe structure, conventional section names, role-relevant terminology, and evidence-backed bullets. Tailor the language to the job description without copying it or inventing experience.",
    href: "/playbooks/cv-ats/",
    label: "CV and ATS resume optimization playbook",
  },
  {
    question: "How can I make my portfolio easier to find?",
    answer:
      "Publish crawlable pages with useful titles, visible summaries, internal links, canonical URLs, accurate structured data, a sitemap, and project case studies that show ownership, constraints, decisions, and proof.",
    href: "/playbooks/web-portfolio/",
    label: "Portfolio SEO, AEO, and AI readability playbook",
  },
  {
    question: "How can I improve my X or Twitter profile?",
    answer:
      "State a clear niche in the bio, use the pinned post as a proof-rich introduction, and build a repeatable posting loop around useful topics instead of relying on disputed algorithm tactics.",
    href: "/playbooks/x-twitter/",
    label: "X and Twitter profile optimization playbook",
  },
  {
    question: "How do I keep every profile consistent?",
    answer:
      "Build one private career context file containing verified roles, projects, achievements, links, constraints, and separately labeled goals. Give that source of truth to the relevant agent skill before each rewrite.",
    href: "/playbooks/agent-context-optimization/",
    label: "AI career context file playbook",
  },
  {
    question: "How do I organize deeper career material?",
    answer:
      "Use VitaeGraph when one compact context file is too flat for thesis work, courses, repository-backed projects, publications, awards, certifications, or long-running experience records.",
    href: "/vitaegraph/",
    label: "VitaeGraph product page",
  },
];
---

<BaseLayout
  meta={meta}
  jsonLd={[
    webPageJsonLd(meta.title, meta.description, meta.path, "CollectionPage"),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Profile Optimization", path: meta.path },
    ]),
  ]}
>
  <section class="page-hero">
    <div class="inner">
      <p class="eyebrow">Choose a workflow</p>
      <h1>Professional profile optimization with AI</h1>
      <p>
        AgentKit SEO is an open-source set of agent skills and human-readable playbooks for improving how your
        experience is understood across LinkedIn, GitHub, resumes, portfolios, X, and private context workflows without fabricating claims.
      </p>
      <div class="actions">
        <a class="button primary" href="/docs/installation/">Install the agent skills</a>
        <a class="button secondary" href={site.repoUrl}>View the GitHub repository</a>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="choose-surface">
    <div class="playbook-quick-head">
      <p class="eyebrow">Find the right answer</p>
      <h2 id="choose-surface">Choose the professional surface you need to improve.</h2>
      <p>
        Each guide is self-contained and links to an installable skill that an AI agent can apply to your supplied
        profile, document, repository, or website.
      </p>
    </div>
    <div class="playbook-library">
      {questions.map((item, index) => (
        <article class="playbook-library-card">
          <span class="quick-card-number">{String(index + 1).padStart(2, "0")}</span>
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
          <a class="text-link" href={item.href}>{item.label} →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section split" aria-labelledby="method-heading">
    <article class="prose">
      <p class="eyebrow">The method</p>
      <h2 id="method-heading">What profile optimization means here</h2>
      <p>
        Profile optimization means making professional information accurate, specific, easy to scan, and easy for
        search systems and AI tools to interpret. It starts with verified facts, then adapts their structure and
        wording to the constraints of one platform.
      </p>
      <ol>
        <li>Collect the existing profile, CV, project links, and other proof.</li>
        <li>Separate verified facts from goals, inference, and unsupported claims.</li>
        <li>Audit one platform against documented constraints and current source-aware guidance.</li>
        <li>Rewrite or implement the highest-impact changes and verify the resulting output.</li>
        <li>Keep the private context file current so future profiles remain consistent.</li>
      </ol>
    </article>
    <aside class="card">
      <h2>SEO, AEO, and GEO</h2>
      <p>
        SEO creates the crawlable and understandable foundation. AEO makes direct answers easy to extract and cite.
        GEO applies the same foundation to generative search experiences through clear entities, original evidence,
        useful page structure, and retrievable public sources.
      </p>
      <p>
        These labels describe overlapping practices, not guaranteed ranking systems. Search and AI providers decide
        what they index, retrieve, summarize, or cite.
      </p>
      <a class="text-link" href="/playbooks/web-portfolio/">Read the web visibility methodology →</a>
    </aside>
  </section>

  <section class="page-section" aria-labelledby="use-cases-heading">
    <div class="playbook-quick-head">
      <p class="eyebrow">Cross-platform use cases</p>
      <h2 id="use-cases-heading">Improve a personal brand and professional online presence</h2>
      <p>
        Start with the outcome you need, then audit only the profiles and documents that support it. The same verified
        career context keeps positioning consistent across every selected surface.
      </p>
    </div>
    <div class="playbook-quick-grid">
      <article>
        <h3>Job search and recruiter visibility</h3>
        <p>Align a targeted resume, LinkedIn profile, GitHub proof, and portfolio around the role being pursued.</p>
      </article>
      <article>
        <h3>Developer portfolio and technical credibility</h3>
        <p>Connect repositories, project case studies, READMEs, technical skills, and public profiles into inspectable proof of work.</p>
      </article>
      <article>
        <h3>Student and early-career positioning</h3>
        <p>Turn education, coursework, projects, research, and extracurricular work into specific evidence without overstating experience.</p>
      </article>
      <article>
        <h3>Founder, freelancer, and creator presence</h3>
        <p>Clarify professional focus, services, public work, and topic positioning across a personal website and social profiles.</p>
      </article>
      <article>
        <h3>Professional profile audit</h3>
        <p>Find inconsistent facts, vague claims, weak proof links, missing keywords, and platform-specific structural problems.</p>
      </article>
      <article>
        <h3>AI-assisted career workflows</h3>
        <p>Give ChatGPT, Claude, Codex, Gemini, or another agent a reusable career knowledge base before requesting profile rewrites.</p>
      </article>
    </div>
  </section>

  <section class="page-section service-strip" aria-labelledby="all-playbooks">
    <div class="playbook-quick-head">
      <p class="eyebrow">Human-readable library</p>
      <h2 id="all-playbooks">Inspect the methods before you run them.</h2>
    </div>
    <div class="service-grid">
      {serviceMarks.map((service) => (
        <a class={`service-mark ${service.tone}`} href={service.href}>
          <span aria-hidden="true"><PlatformIcon kind={service.icon} /></span>
          <h3>{service.name}</h3>
          <p>{service.text}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
