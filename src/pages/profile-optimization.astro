---
import InfoCard from "@components/shared/InfoCard.astro";
import PageHero from "@components/shared/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, webPageJsonLd } from "@data/metadata";

const meta = { title: "Career Context Before Career Workflows", description: "Understand how VitaeContext supplies grounded context to downstream CV, application, profile, portfolio, and interview workflows.", path: "/profile-optimization/", type: "website" as const };
---
<BaseLayout meta={meta} jsonLd={[webPageJsonLd(meta.title, meta.description, meta.path), breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Career workflows", path: meta.path }])]}>
  <PageHero eyebrow="Career workflows" title="Start with context, then choose the tool." text="VitaeContext no longer ships platform-specific adaptation modules. It prepares the reusable context that a downstream career agent or workflow can consume." compact />
  <section class="page-section">
    <div class="card-grid card-grid--three">
      <InfoCard title="Build the shared input" text="Create one maintained Career Context file from the career material you choose to supply." href="/playbooks/context-builder/" label="Open Context Builder" />
      <InfoCard title="Choose an access path" text="Pass a bounded summary, the Markdown file, or selected context through MCP." href="/docs/mcp/" label="Explore MCP" />
      <InfoCard title="Run the downstream task" text="Give the context to the agent or career system that owns the CV, application, profile, or interview workflow." href="/docs/usage/" label="See the full flow" />
    </div>
    <p class="service-note">VitaeContext supplies the context layer. It does not guarantee the quality or outcome of a downstream workflow. For setup commands, use the <a class="text-link" href="/docs/installation/">installation guide</a>.</p>
  </section>
</BaseLayout>
