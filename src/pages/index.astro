---
import CtaBand from "@components/CtaBand.astro";
import PlatformIcon from "@components/PlatformIcon.astro";
import SectionHeader from "@components/SectionHeader.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, organizationJsonLd, softwareJsonLd, websiteJsonLd } from "@data/metadata";
import { serviceMarks, site, skills } from "@data/site";

const meta = {
  title: "AgentKit SEO — Personal Branding for Developers",
  description:
    "AgentKit SEO is an AI-powered personal branding toolkit and modular agent skill system for developers. Covers LinkedIn profile optimization, GitHub SEO, CV/ATS resume optimization, portfolio SEO, X/Twitter strategy, and agent context files. Install via npm for Codex, Claude Code, Gemini CLI, Antigravity, or OpenCode, or through the Claude Code plugin marketplace.",
  path: "/",
};

const benchmarkTakeaways = [
  "Markdown-first",
  "Agent-ready",
  "Provider-aware",
  "Crawler-safe",
];

const quickstart = [
  {
    title: "Choose the surface",
    text: "LinkedIn, GitHub, CV/ATS, portfolio, X/Twitter, or the context file that grounds them all.",
  },
  {
    title: "Use the matching mode",
    text: "Open the playbook for manual work, or install the same method as a provider-aware agent skill.",
  },
  {
    title: "Keep facts aligned",
    text: "Route every rewrite through verified career context so public claims stay consistent.",
  },
];

const skillBundle = [
  {
    title: "Playbook-first structure",
    text: "Readable guides for LinkedIn profile optimization, GitHub SEO, CV/ATS resumes, portfolio SEO, X/Twitter, and career context files.",
  },
  {
    title: "Agent-ready exports",
    text: "The same methodology can be installed as focused skills so an agent loads only the instructions needed for the current surface.",
  },
  {
    title: "Fact alignment",
    text: "Every rewrite is designed to start from a verified context file, keeping public claims consistent across profiles, resumes, and sites.",
  },
  {
    title: "Provider details elsewhere",
    text: "Compatibility, install commands, and provider-specific notes stay on the providers page so the homepage remains easy to scan.",
  },
];
---

<BaseLayout meta={meta} jsonLd={[websiteJsonLd(), organizationJsonLd(), softwareJsonLd(), breadcrumbJsonLd([{ name: "Home", path: "/" }])]}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Personal branding SEO for humans and agents</p>
      <h1 id="hero-title">AgentKit SEO</h1>
      <p class="hero-lede">One career source of truth. Every public surface sharper.</p>
      <p>
        A methodology for LinkedIn profile optimization, GitHub SEO, CV/ATS resume optimization, portfolio indexing,
        X/Twitter positioning, and agent context optimization. Read the playbooks yourself, or install them as focused agent skills from npm.
      </p>
      <ul class="hero-proof-list" aria-label="AgentKit SEO design principles">
        {benchmarkTakeaways.map((takeaway) => <li>{takeaway}</li>)}
      </ul>
      <div class="hero-paths" aria-label="Two ways to use AgentKit SEO">
        <div class="hero-path hero-path--read">
          <span class="hero-path-label">Read the playbooks</span>
          <div class="actions">
            <a class="button primary" href="/playbooks/">Browse playbooks</a>
            <a class="button secondary" href="/docs/">Docs</a>
          </div>
        </div>
        <div class="hero-path-divider" aria-hidden="true">or</div>
        <div class="hero-path hero-path--agent">
          <span class="hero-path-label">Run as agent skills</span>
          <div class="actions">
            <a class="button primary" href="/docs/installation/">Install from npm</a>
            <a class="button secondary" href="/providers/">Providers</a>
          </div>
        </div>
      </div>
    </div>
    <aside class="hero-console" aria-label="AgentKit SEO install and workflow preview">
      <div class="console-topbar" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="console-body">
        <p class="console-label">Install agent skills</p>
        <pre><code>npx agentkit-seo install --provider codex</code></pre>
        <div class="console-flow" aria-label="AgentKit SEO workflow">
          <span>context.md</span>
          <span>skill route</span>
          <span>audits + rewrites</span>
        </div>
        <div class="console-grid">
          {skills.slice(0, 6).map((skill) => (
            <a href={skill.href}>
              <span class="console-skill-icon" aria-hidden="true"><PlatformIcon kind={skill.icon} /></span>
              <strong>{skill.shortName}</strong>
              <span class="console-skill-output">{skill.outputs[0]}</span>
            </a>
          ))}
        </div>
      </div>
    </aside>
  </section>

  <section class="section service-strip">
    <SectionHeader
      eyebrow="What people search for"
      title="Start with the profile surface you need."
      text="Each guide targets a real search intent: LinkedIn profile optimization, GitHub SEO, ATS resume optimization, portfolio indexing, X/Twitter profile strategy, and AI career context files."
    />
    <div class="service-grid">
      {serviceMarks.map((service) => (
        <a class={`service-mark ${service.tone}`} href={service.href} aria-label={`${service.name} playbook`}>
          <span aria-hidden="true"><PlatformIcon kind={service.icon} /></span>
          <h3>{service.name}</h3>
          <p>{service.text}</p>
        </a>
      ))}
    </div>
    <p class="service-note">{site.disclaimer}</p>
  </section>

  <section class="section quickstart-section" aria-labelledby="quickstart-heading">
    <div class="quickstart-copy">
      <p class="eyebrow">Quick start</p>
      <h2 id="quickstart-heading">Three steps, then publish.</h2>
      <p>
        AgentKit SEO is a compact library of profile optimization methods. Pick the surface, choose manual or agent mode,
        and keep every rewrite grounded in the same verified context file.
      </p>
    </div>
    <div class="quickstart-grid">
      {quickstart.map((item) => (
        <article class="quickstart-card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section split skill-bundle-section">
    <div>
      <SectionHeader
        eyebrow="Agent skill bundle"
        title="One method, readable by people and loadable by agents."
        text="The homepage keeps the core promise clear. Provider-specific names, commands, and compatibility notes live on the dedicated providers page."
      />
      <div class="button-row">
        <a class="button primary" href="/docs/installation/">Install skills</a>
        <a class="button secondary" href="/providers/">Provider details</a>
        <a class="button secondary" href="/design/">Design principles</a>
      </div>
    </div>
    <div class="skill-bundle-grid">
      {skillBundle.map((item) => (
        <article class="skill-bundle-card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section authors-section">
    <SectionHeader
      eyebrow="Authors"
      title="Maintained by builders who use the system."
      text="The source repository lists Renato Mignone and Elia Innocenti as the maintainers of AgentKit SEO."
    />
    <div class="author-grid">
      {site.authors.map((author) => (
        <article class="author-card">
          <h3>{author.name}</h3>
          <div class="author-links" aria-label={`${author.name} contact links`}>
            <a href={author.github} target="_blank" rel="noreferrer" aria-label={`${author.name} on GitHub`}>
              <PlatformIcon kind="github" />
              GitHub
            </a>
            <a href={author.linkedin} target="_blank" rel="noreferrer" aria-label={`${author.name} on LinkedIn`}>
              <PlatformIcon kind="linkedin" />
              LinkedIn
            </a>
            <a href={author.portfolio} target="_blank" rel="noreferrer" aria-label={`${author.name}'s portfolio`}>
              <PlatformIcon kind="portfolio" />
              Portfolio
            </a>
            <a href={`mailto:${author.email}`} aria-label={`Email ${author.name}`}>
              <PlatformIcon kind="gmail" />
              Gmail
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CtaBand
    title="Choose the surface and start the optimization."
    text="Install the package from npm when you want the methods inside your agent workflow, or browse the same playbooks as human-readable guides."
    primaryHref="/docs/installation/"
    primaryLabel="Install agent skills"
    secondaryHref="/playbooks/"
    secondaryLabel="Browse playbooks"
  />
</BaseLayout>
