---
import PlatformIcon from "@components/PlatformIcon.astro";
import SectionHeader from "@components/SectionHeader.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, organizationJsonLd, softwareJsonLd, websiteJsonLd } from "@data/metadata";
import { serviceMarks, site } from "@data/site";

const meta = {
  title: "Career Context File and AI Profile Optimization",
  description:
    "Build one private career context file, then use grounded AI agent skills to optimize LinkedIn, GitHub, CV/ATS resumes, portfolios, and X profiles.",
  path: "/",
};

const quickstart = [
  {
    title: "Install the skills",
    text: "Choose your AI tool and install the matching provider bundle.",
    href: "/docs/installation/",
    label: "Installation guide",
  },
  {
    title: "Create your context file",
    text: "Ask the context skill to organize your CV, profiles, projects, goals, and proof links.",
    href: "/docs/context-file-example/",
    label: "See the example file",
  },
  {
    title: "Use one focused skill",
    text: "Attach the context file, choose the platform skill, and describe the task you want to complete.",
    href: "/docs/usage/",
    label: "Usage examples",
  },
];

---

<BaseLayout meta={meta} jsonLd={[websiteJsonLd(), organizationJsonLd(), softwareJsonLd(), breadcrumbJsonLd([{ name: "Home", path: "/" }])]}>
  <section class="hero hero-concept" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Open-source skills for AI agents</p>
      <h1 id="hero-title">One career context file. Grounded AI work for every profile.</h1>
      <p class="hero-lede">Explain your education, experience, projects, skills, goals, and evidence once, then reuse that private context across every career task.</p>
      <p>
        AgentKit SEO combines a reusable Markdown source of truth with focused skills for LinkedIn, GitHub, CV/ATS
        resumes, web portfolios, and X. The context keeps facts grounded; each skill adapts them to one platform.
      </p>
      <div class="hero-paths" aria-label="Get started with AgentKit SEO">
        <div class="hero-path hero-path--read">
          <div class="actions">
            <a class="button primary" href="/docs/context-file-example/">Explore the context file</a>
            <a class="button secondary" href="/profile-optimization/">Choose what to optimize</a>
          </div>
        </div>
      </div>
    </div>
    <div class="concept-flow" aria-label="Career material becomes a reusable context file for focused AI tasks">
      <div class="concept-stage concept-stage--inputs">
        <span class="concept-step">01</span>
        <div>
          <strong>Your existing material</strong>
          <p>CV · profiles · projects · goals</p>
        </div>
      </div>
      <span class="concept-arrow" aria-hidden="true">→</span>
      <a class="concept-file" href="/docs/context-file-example/" aria-label="View an example personal career context file">
        <span class="concept-file-icon"><PlatformIcon kind="context" /></span>
        <div>
          <small>Your reusable context</small>
          <strong>career-context.md</strong>
          <span>private · editable · portable</span>
        </div>
      </a>
      <span class="concept-arrow" aria-hidden="true">→</span>
      <div class="concept-stage concept-stage--tasks">
        <span class="concept-step">02</span>
        <div>
          <strong>One skill and one task</strong>
          <div class="concept-platforms" aria-label="Supported career surfaces">
            {serviceMarks.slice(0, 5).map((service) => (
              <span title={service.name}><PlatformIcon kind={service.icon} /></span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section foundation-section" aria-labelledby="foundation-heading">
    <div class="foundation-head">
      <div>
        <p class="eyebrow">Ground first. Optimize second.</p>
        <h2 id="foundation-heading">One source of truth for every professional profile.</h2>
      </div>
      <p>
        AgentKit SEO separates verified career context from platform-specific presentation. Your facts remain stable;
        each focused skill reshapes them for the surface you are improving.
      </p>
    </div>

    <div class="foundation-flow">
      <article class="foundation-card foundation-card--context">
        <div class="foundation-card-head">
          <span class="foundation-number">01</span>
          <span class="foundation-icon" aria-hidden="true"><PlatformIcon kind="context" /></span>
          <div>
            <p class="eyebrow">Private grounding layer</p>
            <h3>Build your career context file</h3>
          </div>
        </div>
        <p>
          A private Markdown knowledge base for verified education, experience, projects, research, skills,
          certifications, goals, constraints, and proof links.
        </p>
        <ul class="foundation-signals" aria-label="Benefits of a career context file">
          <li><strong>Grounded</strong><span>Facts before rewriting</span></li>
          <li><strong>Consistent</strong><span>One maintained record</span></li>
          <li><strong>Private</strong><span>Your full file stays local</span></li>
        </ul>
        <a class="foundation-link" href="/docs/context-file-example/">Explore the fictional template <span>→</span></a>
      </article>

      <div class="foundation-connector" aria-hidden="true">
        <span>context + skill</span>
        <i>→</i>
      </div>

      <article class="foundation-card foundation-card--profiles">
        <div class="foundation-card-head">
          <span class="foundation-number">02</span>
          <span class="foundation-icon" aria-hidden="true"><PlatformIcon kind="portfolio" /></span>
          <div>
            <p class="eyebrow">Public optimization layer</p>
            <h3>Adapt it to the current platform</h3>
          </div>
        </div>
        <p>
          Improve professional fit and discoverability without inventing experience. Use one focused playbook for
          LinkedIn, GitHub, CV/ATS, web portfolio, or X.
        </p>
        <nav class="foundation-platforms" aria-label="Profile optimization playbooks">
          {serviceMarks.slice(0, 5).map((service) => (
            <a href={service.href}>
              <span aria-hidden="true"><PlatformIcon kind={service.icon} /></span>
              {service.name}
            </a>
          ))}
        </nav>
        <a class="foundation-link" href="/profile-optimization/">Compare every workflow <span>→</span></a>
      </article>
    </div>
  </section>

  <section class="section problem-section daily-workflow-section">
    <div class="problem-copy">
      <p class="eyebrow">Where it fits</p>
      <h2>A small addition to your normal AI workflow.</h2>
      <p>You still use your preferred agent and write normal prompts. AgentKit SEO adds reusable context and a focused set of instructions for the task.</p>
      <a class="text-link" href="/docs/usage/">See a complete usage example →</a>
    </div>
    <div class="answer-card">
      <p class="eyebrow">In practice</p>
      <p>Attach or reference your context file, name the skill you need, and ask for the work directly.</p>
      <dl>
        <div><dt>Context</dt><dd>Your private career file</dd></div>
        <div><dt>Skill</dt><dd>For example, GitHub</dd></div>
        <div><dt>Task</dt><dd>“Audit my profile README”</dd></div>
      </dl>
    </div>
  </section>

  <section class="section workflow-story" aria-labelledby="workflow-heading">
    <div class="workflow-story-head">
      <p class="eyebrow">How it works</p>
      <h2 id="workflow-heading">One context file, then one skill for the current task.</h2>
      <p>Your career material becomes a private context file. Each task combines that file with one platform-specific skill.</p>
    </div>
    <figure class="workflow-figure">
      <img
        src="/brand/workflow-overview.webp"
        alt="AgentKit SEO workflow: scattered career material becomes a personal career context file, passes through focused platform skills, and produces grounded professional outputs"
        width="1672"
        height="941"
        loading="lazy"
      />
      <figcaption>One private context layer prevents every profile, CV, and agent conversation from becoming a separate source of truth.</figcaption>
    </figure>
    <ol class="workflow-steps">
      <li>
        <span>01</span>
        <div>
          <strong>Gather the raw material</strong>
          <p>Start with CVs, profile sections, GitHub and portfolio links, exports, screenshots, project notes, goals, and constraints.</p>
        </div>
      </li>
      <li>
        <span>02</span>
        <div>
          <strong>Create the personal career context file</strong>
          <p>Use the context-optimization skill to organize verified facts, stated goals, proof links, and evidence boundaries in one private Markdown file.</p>
        </div>
      </li>
      <li>
        <span>03</span>
        <div>
          <strong>Load one focused skill</strong>
          <p>Choose LinkedIn, GitHub, CV/ATS, web portfolio, or X/Twitter according to the surface you are improving now.</p>
        </div>
      </li>
      <li>
        <span>04</span>
        <div>
          <strong>Produce grounded work</strong>
          <p>Get an audit, rewrite, code patch, or prioritized action plan based on your supplied context and the platform guidance.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="section service-strip">
    <SectionHeader
      eyebrow="Included skills"
      title="Choose the part of your workflow you are working on."
      text="Each skill contains practical guidance for one platform. You can run it with an agent or read the same material as a playbook."
    />
    <div class="service-grid">
      {serviceMarks.map((service) => (
        <a class={`service-mark ${service.tone}`} href={service.href} aria-label={`${service.name} playbook`}>
          <span aria-hidden="true"><PlatformIcon kind={service.icon} /></span>
          <h3>{service.name}</h3>
          <p>{service.text}</p>
        </a>
      ))}
    </div>
    <p class="service-note">{site.disclaimer}</p>
  </section>

  <section class="section quickstart-section" aria-labelledby="quickstart-heading">
    <div class="quickstart-copy">
      <p class="eyebrow">Getting started</p>
      <h2 id="quickstart-heading">Add it to your workflow in three steps.</h2>
      <p>Start with the context file. After that, you can reuse it for any supported task.</p>
    </div>
    <div class="quickstart-grid">
      {quickstart.map((item) => (
        <article class="quickstart-card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <a class="text-link" href={item.href}>{item.label} →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section proof-section">
    <div class="proof-copy">
      <p class="eyebrow">What is included</p>
      <h2>The instructions are open and readable.</h2>
      <p>The repository contains the skills, human-readable playbooks, source notes, provider adapters, and tests. You can inspect or change any part of the workflow.</p>
    </div>
    <div class="proof-links">
      <a href="/design/"><span>System design</span><strong>How the parts fit together →</strong></a>
      <a href="/playbooks/"><span>Playbooks</span><strong>Read the guidance without installing →</strong></a>
      <a href={site.repoUrl} target="_blank" rel="noreferrer"><span>Source code</span><strong>Open the GitHub repository →</strong></a>
    </div>
  </section>

  <section class="section authors-section">
    <SectionHeader
      eyebrow="Authors"
      title="Maintained by Renato Mignone and Elia Innocenti."
      text="Contact the maintainers, inspect their work, or report a problem in the repository."
    />
    <div class="author-grid">
      {site.authors.map((author) => (
        <article class="author-card">
          <h3>{author.name}</h3>
          <div class="author-links" aria-label={`${author.name} contact links`}>
            <a href={author.github} target="_blank" rel="me noreferrer" aria-label={`${author.name} on GitHub`}>
              <PlatformIcon kind="github" />
              GitHub
            </a>
            <a href={author.linkedin} target="_blank" rel="me noreferrer" aria-label={`${author.name} on LinkedIn`}>
              <PlatformIcon kind="linkedin" />
              LinkedIn
            </a>
            <a href={author.portfolio} target="_blank" rel="me noreferrer" aria-label={`${author.name}'s portfolio`}>
              <PlatformIcon kind="portfolio" />
              Portfolio
            </a>
            <a href={`mailto:${author.email}`} aria-label={`Email ${author.name}`}>
              <PlatformIcon kind="gmail" />
              Gmail
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
