---
import CtaBand from "@components/CtaBand.astro";
import IndexingChecklist from "@components/IndexingChecklist.astro";
import PlatformIcon from "@components/PlatformIcon.astro";
import SectionHeader from "@components/SectionHeader.astro";
import SystemMap from "@components/SystemMap.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { breadcrumbJsonLd, organizationJsonLd, softwareJsonLd, websiteJsonLd } from "@data/metadata";
import { providers, serviceMarks, site, skills, workflow } from "@data/site";

const meta = {
  title: "AgentKit SEO",
  description:
    "AgentKit SEO is a human-readable knowledge hub and modular agent skill system for LinkedIn profile optimization, GitHub SEO, CV/ATS resumes, portfolio SEO, X/Twitter strategy, and agent context files.",
  path: "/",
};

const benchmarkTakeaways = [
  "Markdown-first",
  "Agent-ready",
  "Provider-aware",
  "Crawler-safe",
];

const quickstart = [
  {
    title: "Choose the surface",
    text: "LinkedIn, GitHub, CV/ATS, portfolio, X/Twitter, or the context file that grounds them all.",
  },
  {
    title: "Use the matching mode",
    text: "Open the playbook for manual work, or install the same method as a provider-aware agent skill.",
  },
  {
    title: "Keep facts aligned",
    text: "Route every rewrite through verified career context so public claims stay consistent.",
  },
];
---

<BaseLayout meta={meta} jsonLd={[websiteJsonLd(), organizationJsonLd(), softwareJsonLd(), breadcrumbJsonLd([{ name: "Home", path: "/" }])]}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Personal branding SEO for humans and agents</p>
      <h1 id="hero-title">AgentKit SEO</h1>
      <p class="hero-lede">One career source of truth. Every public surface sharper.</p>
      <p>
        A methodology for LinkedIn profile optimization, GitHub SEO, CV/ATS resume optimization, portfolio indexing,
        X/Twitter positioning, and agent context files. Read the playbooks yourself, or run them as focused agent skills.
      </p>
      <ul class="hero-proof-list" aria-label="AgentKit SEO design principles">
        {benchmarkTakeaways.map((takeaway) => <li>{takeaway}</li>)}
      </ul>
      <div class="hero-paths" aria-label="Two ways to use AgentKit SEO">
        <div class="hero-path hero-path--read">
          <span class="hero-path-label">Read the playbooks</span>
          <div class="actions">
            <a class="button primary" href="/playbooks/">Browse playbooks</a>
            <a class="button secondary" href="/docs/">Docs</a>
          </div>
        </div>
        <div class="hero-path-divider" aria-hidden="true">or</div>
        <div class="hero-path hero-path--agent">
          <span class="hero-path-label">Run as agent skills</span>
          <div class="actions">
            <a class="button primary" href="/docs/installation/">Install</a>
            <a class="button secondary" href="/providers/">Providers</a>
          </div>
        </div>
      </div>
    </div>
    <aside class="hero-console" aria-label="AgentKit SEO install and workflow preview">
      <div class="console-topbar" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="console-body">
        <p class="console-label">Install agent skills</p>
        <pre><code>npx agentkit-seo install --provider codex</code></pre>
        <div class="console-flow" aria-label="AgentKit SEO workflow">
          <span>context.md</span>
          <span>skill route</span>
          <span>audits + rewrites</span>
        </div>
        <div class="console-grid">
          {skills.slice(0, 6).map((skill) => (
            <a href={skill.href}>
              <strong>{skill.shortName}</strong>
              <span>{skill.outputs[0]}</span>
            </a>
          ))}
        </div>
      </div>
    </aside>
  </section>

  <section class="section quickstart-section" aria-labelledby="quickstart-heading">
    <div class="quickstart-copy">
      <p class="eyebrow">Quick start</p>
      <h2 id="quickstart-heading">Start with the surface you need.</h2>
      <p>
        AgentKit SEO is a compact library of profile optimization methods. Pick the surface, choose manual or agent mode,
        and keep every rewrite grounded in the same verified context file.
      </p>
    </div>
    <div class="quickstart-grid">
      {quickstart.map((item) => (
        <article class="quickstart-card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <SystemMap />

  <!-- Two-mode explainer -->
  <section class="section two-mode-section" aria-labelledby="two-mode-heading">
    <SectionHeader
      eyebrow="Two ways to use it"
      title="A knowledge base first, a skill bundle second."
      text="The repository is designed to be read directly by anyone doing profile work. It can also be exported as focused agent skills for automated workflows. Both modes use exactly the same methodology."
    />
    <div class="two-mode-split">
      <article class="mode-card mode-card--read">
        <div class="mode-card-header">
          <span class="mode-badge mode-badge--read">Playbooks</span>
          <h3>Read the methodology yourself</h3>
        </div>
        <p>
          Each module is written as a structured, human-readable guide. You bring the context about your career, read
          the relevant sections, and apply the checks and rewrites manually. No agent, no install, no commands.
        </p>
        <ul class="mode-list">
          <li>Practical checklists for each platform surface</li>
          <li>Opinionated structure you can follow step by step</li>
          <li>Covers LinkedIn, GitHub, CV/ATS, portfolio, X/Twitter, and context files</li>
          <li>Works independently from any AI tooling</li>
        </ul>
        <a class="button primary mode-card-cta" href="/playbooks/">Browse playbooks →</a>
      </article>
      <article class="mode-card mode-card--agent">
        <div class="mode-card-header">
          <span class="mode-badge mode-badge--agent">Agent skills</span>
          <h3>Install as focused agent skills</h3>
        </div>
        <p>
          The same methodology is packaged as named agent skills for Codex, Claude Code, Gemini CLI, and OpenCode.
          An agent loads only the skill it needs, receives scoped rules for the target surface, and applies them
          against your private context file.
        </p>
        <ul class="mode-list">
          <li>One skill per surface, keeping context small and focused</li>
          <li>Provider-aware install layouts via a single export script</li>
          <li>Context file keeps facts consistent across every agent run</li>
          <li>Outputs: audits, rewrites, checklists, and patch plans</li>
        </ul>
        <a class="button primary mode-card-cta" href="/docs/installation/">Read installation →</a>
      </article>
    </div>
  </section>

  <section class="section service-strip">
    <SectionHeader
      eyebrow="What people search for"
      title="Built around the profile problems that actually get queried."
      text="Each surface gets its own visible target: LinkedIn profile optimization, GitHub repository SEO, ATS resume optimization, portfolio indexing, X/Twitter profile strategy, and agent context architecture."
    />
    <div class="service-grid">
      {serviceMarks.map((service) => (
        <article class={`service-mark ${service.tone}`}>
          <span aria-hidden="true"><PlatformIcon kind={service.icon} /></span>
          <h3>{service.name}</h3>
          <p>{service.text}</p>
        </article>
      ))}
    </div>
    <p class="service-note">{site.disclaimer}</p>
  </section>

  <section class="section">
    <SectionHeader
      eyebrow="Surface matrix"
      title="Every profile gets the rules it deserves."
      text="Each module maps a public surface to specific checks, rewrites, and output types. Read it as a guide or invoke it as an agent skill."
    />
    <div class="matrix">
      {skills.map((skill) => (
        <a href={skill.href}>
          <span class="icon" aria-hidden="true"><PlatformIcon kind={skill.icon} /></span>
          <h3>{skill.shortName}</h3>
          <p>{skill.summary}</p>
          <p class="search-intent">{skill.searchIntent}</p>
          <ul class="tag-list" aria-label={`${skill.name} outputs`}>
            {skill.outputs.slice(0, 2).map((output) => <li>{output}</li>)}
          </ul>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <SectionHeader
      eyebrow="Workflow"
      title="From scattered material to consistent updates."
      text="The system is designed for repeatable work, not one-off prompt improvisation. It works the same whether you're reading the guide yourself or routing a task through an agent."
    />
    <div class="workflow">
      {workflow.map((step) => (
        <article class="step">
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section split">
    <div>
      <SectionHeader
        eyebrow="Provider support"
        title="Portable skills, provider-aware installs."
        text="The shared skill source exports to supported agent environments while keeping the methodology in one place."
      />
      <a class="button secondary" href="/providers/">Compare providers</a>
    </div>
    <div class="provider-list">
      {providers.map((provider) => (
        <article class="provider">
          <h3>{provider.name}</h3>
          <p><strong>{provider.status}</strong><br />{provider.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <IndexingChecklist />

  <section class="section authors-section">
    <SectionHeader
      eyebrow="Authors"
      title="Maintained by builders who use the system."
      text="The source repository lists Renato Mignone and Elia Innocenti as the maintainers of AgentKit SEO."
    />
    <div class="author-grid">
      {site.authors.map((author) => (
        <article class="author-card">
          <h3>{author.name}</h3>
          <div class="author-links" aria-label={`${author.name} contact links`}>
            <a href={author.github} target="_blank" rel="noreferrer" aria-label={`${author.name} on GitHub`}>
              <PlatformIcon kind="github" />
              GitHub
            </a>
            <a href={author.linkedin} target="_blank" rel="noreferrer" aria-label={`${author.name} on LinkedIn`}>
              <PlatformIcon kind="linkedin" />
              LinkedIn
            </a>
            <a href={author.portfolio} target="_blank" rel="noreferrer" aria-label={`${author.name}'s portfolio`}>
              <PlatformIcon kind="portfolio" />
              Portfolio
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <SectionHeader
      eyebrow="SEO/AEO positioning"
      title="Built for search engines, recruiters, profile parsers, and AI agents."
      text="AgentKit SEO treats crawler visibility and AI-readable structure as career infrastructure. Metadata, profile copy, repository descriptions, project pages, and context files point back to the same verified facts."
    />
    <div class="grid">
      <article class="card">
        <h3>Crawler-aware</h3>
        <p>Portfolio guidance covers crawlable URLs, metadata, structured data, sitemaps, robots files, and JavaScript SEO.</p>
      </article>
      <article class="card">
        <h3>Parser-aware</h3>
        <p>CV guidance prioritizes extractable text, standard sections, role keywords, and recruiter scanning.</p>
      </article>
      <article class="card">
        <h3>Agent-aware</h3>
        <p>Skills are small enough for focused loading and strict enough to preserve facts across platforms.</p>
      </article>
    </div>
  </section>

  <CtaBand
    title="Choose your path: read the playbooks or install the skills."
    text="Browse the methodology as structured guides, or install the agent skills and route your first surface through the matching skill."
    primaryHref="/skills/"
    primaryLabel="Browse skills"
    secondaryHref="/docs/installation/"
    secondaryLabel="Install agent skills"
  />
</BaseLayout>
