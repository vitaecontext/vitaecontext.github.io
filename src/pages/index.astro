---
import BaseLayout from "@layouts/BaseLayout.astro";
import LandingHero from "@components/landing/LandingHero.astro";
import ContextLayer from "@components/landing/ContextLayer.astro";
import ContextStory from "@components/landing/ContextStory.astro";
import SkillsWorkbench from "@components/landing/SkillsWorkbench.astro";
import GroundingSection from "@components/landing/GroundingSection.astro";
import VitaeGraphBridge from "@components/landing/VitaeGraphBridge.astro";
import StartSection from "@components/landing/StartSection.astro";
import { breadcrumbJsonLd, organizationJsonLd, softwareJsonLd, websiteJsonLd } from "@data/metadata";
import "@styles/pages/landing.css";

const meta = {
  title: "One Career Context for Grounded AI Work",
  description:
    "Create reusable, evidence-bounded career context before AI-assisted CVs, applications, profiles, and other professional work—then use it in any provider or system that accepts context.",
  path: "/",
};
---

<BaseLayout meta={meta} jsonLd={[websiteJsonLd(), organizationJsonLd(), softwareJsonLd(), breadcrumbJsonLd([{ name: "Home", path: "/" }])] }>
  <div class="landing-shell">
    <LandingHero />
    <ContextLayer />
    <ContextStory />
    <SkillsWorkbench />
    <GroundingSection />
    <VitaeGraphBridge />
    <StartSection />
  </div>
</BaseLayout>
