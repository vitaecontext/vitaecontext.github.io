---
import PlatformIcon from "@components/PlatformIcon.astro";
import VitaeGraph3D from "@components/vitaegraph/VitaeGraph3D.jsx";
import VitaeGraphStaticPreview from "@components/vitaegraph/VitaeGraphStaticPreview.astro";
import { site } from "@data/site-config";
---

<section class="vg-new-hero" aria-labelledby="vitaegraph-title">
  <div class="vg-wrap vg-new-hero__grid">
    <div class="vg-new-hero__copy">
      <p class="vg-brand-lockup" aria-label="VitaeGraph, powered by VitaeContext">
        <span class="vg-brand-word" aria-hidden="true">VitaeGraph</span>
        <span class="vg-brand-tail">powered by VitaeContext</span>
      </p>
      <p class="vg-kicker"><span></span> Deeper structured career context</p>
      <h1 id="vitaegraph-title">Detailed career context, stored as connected Markdown records.</h1>
      <p class="vg-new-hero__lede">
        VitaeGraph organizes detailed projects, roles, education, courses, thesis work, credentials, awards, and
        publications as local Markdown records—and preserves meaningful relationships between them.
      </p>
      <p class="vg-new-hero__relationship">
        <strong>VitaeContext gives agents the compact overview.</strong> VitaeGraph is the optional deeper layer for
        tasks that need specific records and connections.
      </p>
      <div class="vg-actions">
        <a class="vg-button vg-button--primary" href="#get-started">Set up VitaeGraph</a>
        <a class="vg-button" href="#records">See the record model</a>
        <a class="vg-text-link" href={`${site.repoUrl}/tree/main/vitaegraph`} target="_blank" rel="noreferrer">
          Read specification <span aria-hidden="true">↗</span>
        </a>
      </div>
      <ul class="vg-new-hero__facts" aria-label="VitaeGraph qualities">
        <li><span>MD</span> Markdown canonical</li>
        <li><span><PlatformIcon kind="graph" /></span> Hierarchy + cross-links</li>
        <li><span>⌂</span> Local-first</li>
      </ul>
    </div>

    <div class="vg-graph-workspace" aria-label="Interactive sample 3D representation of a VitaeGraph career knowledge base">
      <p class="vg-graph-workspace__label"><span></span> Sample career knowledge graph · drag to explore</p>
      <VitaeGraph3D client:only="react" variant="hero">
        <VitaeGraphStaticPreview slot="fallback" />
      </VitaeGraph3D>
      <noscript>
        <p class="vg3d-noscript">
          JavaScript is required for interactive sample. VitaeGraph itself remains plain Markdown and rebuildable local JSON.
        </p>
      </noscript>
    </div>
  </div>
</section>
