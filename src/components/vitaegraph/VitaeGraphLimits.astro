---
import { site } from "@data/site";
---

<section class="page-section vg-limits-section" aria-labelledby="limits-heading">
  <div class="vg-limit-card">
    <p class="eyebrow">Scope and limits</p>
    <h2 id="limits-heading">Structure, not magic verification.</h2>
    <p>
      VitaeGraph structures supplied material. It does not verify career claims automatically, guarantee retrieval
      quality, guarantee platform outcomes, or replace human review. Generated graph and search-index JSON files are
      deterministic convenience artifacts, not ranking or quality guarantees.
    </p>
    <div class="actions">
      <a class="button primary vg-primary-button" href="#graph-explorer">Return to the graph</a>
      <a class="button secondary" href={`${site.repoUrl}/tree/main/vitaegraph`} target="_blank" rel="noreferrer">Read the VitaeGraph spec</a>
    </div>
  </div>
</section>
