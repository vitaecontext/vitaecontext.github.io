---
const routeNodes = [
  {
    label: "Flat material",
    title: "CV, profiles, notes",
    text: "Career facts start scattered and compressed.",
  },
  {
    label: "Overview",
    title: "Career context file",
    text: "One portable Markdown file gives agents the compact map.",
  },
  {
    label: "Depth",
    title: "VitaeGraph records",
    text: "Projects, roles, education, skills, proof, and repositories become linked records.",
  },
  {
    label: "Indexes",
    title: "graph.json + search",
    text: "Generated artifacts make the graph inspectable and rebuildable.",
  },
  {
    label: "Task",
    title: "Agent request",
    text: "The agent enters the graph from a concrete goal.",
  },
  {
    label: "Focus",
    title: "Relevant subgraph",
    text: "Only connected records that matter are pulled forward.",
  },
  {
    label: "Output",
    title: "Grounded result",
    text: "CVs, answers, profile rewrites, and portfolio copy stay tied to the graph path.",
  },
];
---

<section class="page-section vg-looking-section" aria-labelledby="looking-heading">
  <div class="vg-section-head vg-section-head--wide">
    <p class="eyebrow">One graph. Multiple lenses.</p>
    <h2 id="looking-heading">Watch flat career material become a route an agent can follow.</h2>
    <p>
      VitaeGraph is not another portfolio surface. It is the structure behind the surface: overview, deep records,
      generated indexes, task routing, focused retrieval, and grounded output.
    </p>
  </div>
  <ol class="vg-system-route" aria-label="VitaeGraph route from flat career material to grounded output">
    {routeNodes.map((node, index) => (
      <li class={`vg-route-node vg-route-node--${index + 1}`}>
        <span class="vg-route-dot" aria-hidden="true"></span>
        <p class="vg-route-label">{node.label}</p>
        <h3>{node.title}</h3>
        <p>{node.text}</p>
      </li>
    ))}
  </ol>
</section>
