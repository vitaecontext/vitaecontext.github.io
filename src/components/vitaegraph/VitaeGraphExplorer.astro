---
const graphLenses = [
  {
    label: "Core",
    title: "VitaeGraph",
    text: "The root node that gives the graph a schema, identity, and local workspace.",
    x: "50%",
    y: "50%",
  },
  {
    label: "Clusters",
    title: "Projects · roles · education · skills · certifications",
    text: "Neighborhoods keep the career readable without flattening everything into one file.",
    x: "18%",
    y: "32%",
  },
  {
    label: "Evidence",
    title: "GitHub, proof links, publications",
    text: "Proof attaches to the records it supports, instead of sitting as generic links.",
    x: "28%",
    y: "72%",
  },
  {
    label: "Generated",
    title: "graph.json, search-index.json, diagnostics.json",
    text: "Indexes are generated from Markdown, useful for agents, and safe to rebuild.",
    x: "73%",
    y: "30%",
  },
  {
    label: "Outputs",
    title: "Tailored CV, LinkedIn rewrite, application answers",
    text: "Outputs are produced from selected graph paths, not from memory or a giant prompt dump.",
    x: "80%",
    y: "70%",
  },
];
---

<section class="page-section vg-read-graph-section" aria-labelledby="read-graph-heading">
  <div class="vg-section-head vg-section-head--wide">
    <p class="eyebrow">Graph lenses</p>
    <h2 id="read-graph-heading">The same career graph can be read as structure, proof, indexes, or output path.</h2>
    <p>
      Instead of scrolling through boxes, the agent follows relationships. Core records branch into clusters, connect to
      evidence, generate indexes, and route toward the output the task needs.
    </p>
  </div>
  <div class="vg-lens-map" aria-label="VitaeGraph graph lenses">
    <span class="vg-lens-edge vg-lens-edge--clusters" aria-hidden="true"></span>
    <span class="vg-lens-edge vg-lens-edge--evidence" aria-hidden="true"></span>
    <span class="vg-lens-edge vg-lens-edge--generated" aria-hidden="true"></span>
    <span class="vg-lens-edge vg-lens-edge--outputs" aria-hidden="true"></span>
    <span class="vg-lens-route" aria-hidden="true"></span>
    {graphLenses.map((lens) => (
      <article class={`vg-lens-node vg-lens-node--${lens.label.toLowerCase()}`} style={`--x: ${lens.x}; --y: ${lens.y};`}>
        <span class="vg-lens-dot" aria-hidden="true"></span>
        <p>{lens.label}</p>
        <h3>{lens.title}</h3>
        <small>{lens.text}</small>
      </article>
    ))}
  </div>
</section>
