---
import PlatformIcon from "@components/PlatformIcon.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { skills } from "@data/skills";
---

<section class="feature-section page-wrap" aria-labelledby="skill-catalog-title">
  <SectionIntro eyebrow="Three small runtime skills" title="Build and retrieve context, then hand it off." text="The package contains a router, the Context Builder, and VitaeGraph. Platform-specific adaptation belongs to the downstream tool that consumes the context." />
  <div class="catalog-grid">
    {skills.map((skill) => (
      <a class:list={["catalog-card", { "catalog-card--vitae": skill.slug === "vitaegraph" }]} href={skill.href}>
        <span class="catalog-card__icon" aria-hidden="true"><PlatformIcon kind={skill.icon} /></span>
        <div>
          <p class="catalog-card__name">{skill.invocationName ?? `vitaecontext-${skill.slug}`}</p>
          <h2>{skill.shortName}</h2>
          <p>{skill.summary}</p>
        </div>
        <span class="text-link">View skill <span aria-hidden="true">↗</span></span>
      </a>
    ))}
  </div>
  <p class="service-note">Installation and activation vary by provider, but the Career Context artifact remains portable Markdown. <a class="text-link" href="/docs/usage/">See the context-first workflow</a>.</p>
</section>
