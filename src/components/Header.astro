---
import PlatformIcon from "@components/PlatformIcon.astro";
import { navItems } from "@data/navigation";
import { site } from "@data/site-config";
import "@styles/components/header.css";

const currentPath = Astro.url.pathname;
const regularNavItems = navItems.filter((item) => item.placement === "primary");
const vitaeGraphItem = navItems.find((item) => item.placement === "product");
const githubItem = navItems.find((item) => item.placement === "external");
---

<header class="site-header">
  <a class="brand" href="/" aria-label={`${site.name} home`}>
    <img class="brand-mark" src="/brand/agentkit-seo-mark.svg" alt="" width="36" height="36" loading="eager" decoding="async" />
    <span>{site.name}</span>
  </a>
  <nav class="nav" id="primary-navigation" aria-label="Primary navigation" data-primary-nav>
    {regularNavItems.map((item) => {
      const isExternal = item.href.startsWith("http");
      const isCurrent = !isExternal && (currentPath === item.href || currentPath.startsWith(item.href));
      return <a href={item.href} aria-current={isCurrent ? "page" : undefined} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noreferrer" : undefined}>{item.label}</a>;
    })}
  </nav>
  <div class="header-actions">
    <button class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme" data-theme-toggle>
      <span class="theme-toggle-sun" aria-hidden="true"></span>
      <span class="theme-toggle-moon" aria-hidden="true"></span>
    </button>
    {vitaeGraphItem && (
      <a
        href={vitaeGraphItem.href}
        class="vitaegraph-nav-btn"
        aria-current={currentPath === vitaeGraphItem.href || currentPath.startsWith(vitaeGraphItem.href) ? "page" : undefined}
      >
        <PlatformIcon kind="graph" class="vitaegraph-mark-icon" />
        <span>VitaeGraph</span>
      </a>
    )}
    {githubItem && (
      <a href={githubItem.href} class="github-nav-btn" target="_blank" rel="noreferrer" aria-label="View on GitHub">
        <PlatformIcon kind="github" class="github-mark-icon" />
        <span>GitHub</span>
      </a>
    )}
    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-menu-toggle
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const setMenu = (open: boolean) => {
    const header = document.querySelector<HTMLElement>(".site-header");
    const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    if (!header || !menuToggle) return;
    header.dataset.menuOpen = open ? "true" : "false";
    menuToggle.setAttribute("aria-expanded", String(open));
    menuToggle.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
  };

  const setThemeLabel = (toggle: HTMLButtonElement) => {
    const root = document.documentElement;
    const theme = root.dataset.theme === "dark" ? "dark" : "light";
    toggle.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} theme`);
    toggle.dataset.activeTheme = theme;
  };

  const syncHeader = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach(setThemeLabel);
    setMenu(false);
  };

  const appWindow = window as typeof window & { __agentkitHeaderBound?: boolean };

  if (!appWindow.__agentkitHeaderBound) {
    appWindow.__agentkitHeaderBound = true;

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const themeToggle = target?.closest<HTMLButtonElement>("[data-theme-toggle]");
      if (themeToggle) {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("agentkit-theme", next);
        setThemeLabel(themeToggle);
        return;
      }

      const menuToggle = target?.closest<HTMLButtonElement>("[data-menu-toggle]");
      if (menuToggle) {
        setMenu(menuToggle.getAttribute("aria-expanded") !== "true");
        return;
      }

      if (target?.closest("[data-primary-nav] a")) setMenu(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMenu(false);
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 720) setMenu(false);
    });
  }

  syncHeader();
</script>
