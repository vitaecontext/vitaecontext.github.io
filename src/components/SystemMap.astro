---
import { skills } from "@data/site";
---

<section class="section system-map" aria-labelledby="system-map-heading">
  <div class="map-copy">
    <p class="eyebrow">System map</p>
    <h2 id="system-map-heading">Turn scattered career material into surface-specific output.</h2>
    <p>
      AgentKit SEO keeps the durable facts in one private context file, then routes each publishing job through the
      smallest skill that knows the target surface.
    </p>
  </div>
  <div class="map-visual" aria-label="AgentKit SEO flow from context to public surfaces">
    <div class="map-node source">
      <span>01</span>
      <strong>Context file</strong>
      <small>Roles, links, projects, proof, tone</small>
    </div>
    <div class="map-node hub">
      <span>02</span>
      <strong>AgentKit SEO</strong>
      <small>Route, audit, generate, verify</small>
    </div>
    <div class="surface-stack">
      {skills.map((skill) => (
        <a href={skill.href}>
          <span>{skill.shortName}</span>
          <small>{skill.outputs[0]}</small>
        </a>
      ))}
    </div>
  </div>
</section>
