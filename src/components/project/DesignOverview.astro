---
import SectionIntro from "@components/shared/SectionIntro.astro";
import { site } from "@data/site-config";

const layers = [
  { title: "Supplied material", text: "CVs, profiles, projects, links, notes, goals, and constraints selected by the person." },
  { title: "Career Context", text: "A maintained Markdown file stores reusable facts, intent, evidence boundaries, and claims to avoid." },
  { title: "Controlled access", text: "A bounded summary, direct file, or stateless MCP server exposes only the context needed for the task." },
  { title: "Downstream systems", text: "Career agents and tools apply their own methods to produce CVs, applications, profiles, and other work." },
];

const labels = [
  ["Project fact", "Confirmed by current package source or maintained project documentation."],
  ["Supplied career fact", "Taken from user-provided or inspected material; not independently authenticated by VitaeContext."],
  ["From source", "Taken from another supplied source."],
  ["Inference", "Reasoned from evidence but not directly observed."],
  ["Inaccessible", "Could not be inspected."],
  ["Needs evidence", "Should not become a public claim yet."],
];
---

<div class="design-overview page-wrap">
  <section>
    <SectionIntro eyebrow="Product model" title="Context and execution stay separate." text="VitaeContext maintains the grounded input. Downstream systems own the task method and final output." />
    <div class="design-flow">
      {layers.map((layer, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><h2>{layer.title}</h2><p>{layer.text}</p></article>)}
    </div>
  </section>

  <section>
    <SectionIntro eyebrow="Canonical project facts" title="One project, package, and source." text="VitaeContext is the current project identity. The public implementation is open source under the MIT license, and the website mirrors the package rather than defining separate runtime behavior." />
    <dl class="definition-list">
      <div><dt>Project and package</dt><dd><strong>VitaeContext</strong> · <code>vitaecontext</code> · version {site.packageVersion}</dd></div>
      <div><dt>Canonical source</dt><dd><a class="text-link" href="https://github.com/vitaecontext/vitaecontext">github.com/vitaecontext/vitaecontext</a></dd></div>
      <div><dt>License</dt><dd><a class="text-link" href="https://github.com/vitaecontext/vitaecontext/blob/main/LICENSE">MIT License</a></dd></div>
      <div><dt>Creators and maintainers</dt><dd><a class="text-link" href="/contact/">Renato Mignone and Elia Innocenti</a></dd></div>
    </dl>
  </section>

  <section class="design-split">
    <div><p class="eyebrow">Progressive disclosure</p><h2>Retrieve the smallest useful context.</h2><p>Most tasks need the compact Career Context file or a bounded summary. VitaeGraph adds selected deep records only when a task needs more detail.</p></div>
    <pre class="code-block"><code>request
  └── Career Context
      ├── bounded task summary
      └── selected VitaeGraph records
          └── downstream workflow</code></pre>
  </section>

  <section>
    <SectionIntro eyebrow="Evidence vocabulary" title="Make certainty visible." text="Shared labels stop inference, goals, and inaccessible material from being presented as verified experience." />
    <dl class="label-grid">{labels.map(([label, text]) => <div><dt>{label}</dt><dd>{text}</dd></div>)}</dl>
  </section>

  <section class="design-note">
    <h2>What the system does not guarantee</h2>
    <p>VitaeContext does not authenticate every real-world claim or guarantee rankings, recruiter attention, visibility, or career outcomes. Generated work still requires human review.</p>
  </section>
</div>
