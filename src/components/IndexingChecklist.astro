---
import SectionHeader from "@components/SectionHeader.astro";
import { indexingSignals } from "@data/site";
---

<section class="section index-section" aria-labelledby="indexing-heading">
  <SectionHeader
    eyebrow="Indexing posture"
    title="Readable by people, parsers, crawlers, and agents."
    text="The web portfolio guidance treats indexability as a product feature: real pages, aligned metadata, explicit links, and durable source facts."
  />
  <div class="index-grid">
    {indexingSignals.map((signal) => (
      <article class="index-item">
        <h3>{signal.title}</h3>
        <p>{signal.text}</p>
      </article>
    ))}
  </div>
</section>
