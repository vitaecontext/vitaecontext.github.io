---
import PlatformIcon from "@components/PlatformIcon.astro";
import { navItems, site } from "@data/site";

const footerNavItems = navItems.filter(
  (item) => !["GitHub"].includes(item.label)
);
---

<footer class="site-footer">
  <div class="footer-left">
    <a class="footer-brand" href="/" aria-label={`${site.name} home`}>
      <img class="brand-mark" src="/brand/agentkit-seo-mark.svg" alt="" width="36" height="36" loading="lazy" decoding="async" />
      <span>{site.name}</span>
    </a>
    <p class="footer-tagline">Personal branding SEO for humans and agents.</p>
    <p class="footer-legal">{site.disclaimer}</p>
  </div>

  <div class="footer-right">
    <div class="footer-nav-group">
      <p class="footer-nav-label">Pages</p>
      <nav aria-label="Footer navigation">
        {footerNavItems.map((item) => {
          const isExternal = item.href.startsWith("http");
          return (
            <a
              href={item.href}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noreferrer" : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="footer-nav-group">
      <p class="footer-nav-label">Authors</p>
      <div class="footer-authors-list">
        {site.authors.map((author) => (
          <div class="footer-author">
            <span class="footer-author-name">{author.name}</span>
            <div class="footer-author-links">
              <a href={author.github} target="_blank" rel="noreferrer" aria-label={`${author.name} on GitHub`}>
                <PlatformIcon kind="github" />
                GitHub
              </a>
              <a href={author.linkedin} target="_blank" rel="noreferrer" aria-label={`${author.name} on LinkedIn`}>
                <PlatformIcon kind="linkedin" />
                LinkedIn
              </a>
              <a href={author.portfolio} target="_blank" rel="noreferrer" aria-label={`${author.name}'s portfolio`}>
                <PlatformIcon kind="portfolio" />
                Portfolio
              </a>
              <a href={`mailto:${author.email}`} aria-label={`Email ${author.name}`}>
                <PlatformIcon kind="gmail" />
                Gmail
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</footer>
