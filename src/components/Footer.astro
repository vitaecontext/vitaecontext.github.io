---
import { footerGroups } from "@data/navigation";
import { site } from "@data/site-config";
import "@styles/components/footer.css";

---

<footer class="site-footer">
  <div class="footer-left">
    <a class="footer-brand" href="/" aria-label={`${site.name} home`}>
      <img class="brand-mark" src="/icons/icon-192.png" alt="" width="36" height="36" loading="lazy" decoding="async" />
      <span>{site.name}</span>
    </a>
    <p class="footer-tagline">Reusable career context and focused methods for AI-assisted work.</p>
    <p class="footer-legal">{site.disclaimer}</p>
  </div>

  <div class="footer-right">
    {footerGroups.map((group) => (
      <div class="footer-nav-group">
        <p class="footer-nav-label">{group.label}</p>
        <nav aria-label={`${group.label} links`}>
          {group.links.map((item) => {
            const isExternal = item.href.startsWith("http");
            return <a href={item.href} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noreferrer" : undefined}>{item.label}</a>;
          })}
        </nav>
      </div>
    ))}
  </div>
</footer>
