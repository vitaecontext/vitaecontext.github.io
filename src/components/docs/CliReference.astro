---
import { marketplace } from "@data/navigation";

const commands = [
  ["version", "npx vitaecontext version", "Print the running package version."],
  ["update", "npx vitaecontext update [--provider <provider>] [--json] [--timeout <ms>]", "Check npm for a newer version. This runs only when requested."],
  ["doctor", "npx vitaecontext doctor", "Validate package structure, skill metadata, wiki files, provider manifests, and packaged paths."],
  ["list providers", "npx vitaecontext list providers", "List supported install targets."],
  ["list skills", "npx vitaecontext list skills", "List runtime skills in the package."],
  ["list commands", "npx vitaecontext list commands --provider <provider>", "List command wrappers for one provider."],
  ["template context", "npx vitaecontext template context --output ~/.vitaecontext/name-surname-career-context.md", "Create the guided career context template at a chosen path."],
  ["context init", "npx vitaecontext context init --output ~/.vitaecontext/name-surname-career-context.md", "Create a minimal private Career Context starter. Without --output, use ~/.vitaecontext/career-context.md."],
  ["context validate", "npx vitaecontext context validate <file> [--json]", "Check the Career Context structure and internal consistency. This does not authenticate real-world facts."],
  ["context summary", "npx vitaecontext context summary <file> --for github --output /tmp/github-context.md", "Create a bounded task packet for CV, GitHub, LinkedIn, portfolio, X, or general use."],
  ["graph init", "npx vitaecontext graph init --root ~/.vitaecontext/vitaegraph", "Create the initial VitaeGraph Markdown workspace."],
  ["graph validate", "npx vitaecontext graph validate --root ~/.vitaecontext/vitaegraph", "Check IDs, record types, links, parents, relationships, and duplicates."],
  ["graph index", "npx vitaecontext graph index --root ~/.vitaecontext/vitaegraph", "Build deterministic graph and lexical JSON indexes from Markdown."],
  ["install", "npx vitaecontext install --provider <provider> [--target-dir <path>]", "Install provider files and write an install manifest."],
  ["uninstall", "npx vitaecontext uninstall --provider <provider> [--dry-run] [--force]", "Remove files recorded in the install manifest."],
  ["export", "npx vitaecontext export --provider <provider|all>", "Generate provider layouts from the canonical runtime source."],
];
---

<div class="doc-body page-wrap prose">
  <p>Run commands with <code>npx vitaecontext &lt;command&gt;</code>. Commands below describe package behavior, not operations performed by this website.</p>
  <div class="command-list">
    {commands.map(([name, syntax, text]) => <section><h2><code>vitaecontext {name}</code></h2><pre class="code-block"><code>{syntax}</code></pre><p>{text}</p></section>)}
  </div>
  <section><h2>Claude Code marketplace</h2><pre class="code-block"><code>{marketplace.addCommand}
{marketplace.installCommand}</code></pre></section>
</div>
