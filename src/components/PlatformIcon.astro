---
const { kind = "package", title, class: className = "" } = Astro.props;
const normalized = (kind || "package").toLowerCase();
const svgClass = ["platform-icon", `platform-icon--${normalized}`, className].filter(Boolean).join(" ");
const titleId = title ? `platform-icon-${normalized}` : undefined;

let viewBox = "0 0 24 24";

if (normalized === "github") {
  viewBox = "0 0 16 16";
} else if (normalized === "gemini") {
  viewBox = "0 0 50 50";
} else if (normalized === "opencode") {
  viewBox = "0 6 24 30";
}
---

<svg
  class={svgClass}
  viewBox={viewBox}
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  aria-labelledby={titleId}
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
