{
  "name": "vitaecontext.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --root . --host 127.0.0.1",
    "og:generate": "node scripts/generate-og-images.mjs",
    "sync:product": "node scripts/sync-playbooks.mjs",
    "sync:check": "node scripts/sync-playbooks.mjs --check",
    "build": "astro check --root . && astro build --root . --outDir ./dist",
    "seo:audit": "node scripts/seo-audit.mjs",
    "preview": "astro preview --root . --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-force-graph-3d": "^1.29.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^7.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.0.6",
    "typescript": "^5.9.3"
  }
}
